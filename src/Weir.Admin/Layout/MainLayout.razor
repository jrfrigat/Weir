@inherits LayoutComponentBase
@implements IDisposable
@inject TokenStore Tokens
@inject WeirAuthStateProvider Auth
@inject WeirApiClient Api
@inject NavigationManager Navigation
@inject LanguageService Lang
@inject ScreenFitState ScreenFit

@* Command Center shell, composed from Flare: a top app bar with route tabs over a scrolling content
   region. A single fixed theme (Visual Studio 2026 geometry, Command Center palette) - no switcher.
   The signed-in user's name on the right is a menu: Account / Sign out. *@
<FlareLayout>
    @* A 43px nav bar (the Command Center design's 50px, tightened). Height is a first-class parameter and
       Flare writes it to --flare-layout-appbar-height, which the shell's grid row reads; the bar keeps its
       bottom border by default, so the only thing left here is lifting its surface above the canvas, via
       the dedicated --flare-layout-appbar-bg token. *@
    <FlareLayoutAppBar Height="43px" Style="--flare-layout-appbar-bg:var(--flare-color-surface-container-low);">
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium" Style="width:100%;min-width:0;">
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                <WeirMark Size="1.6rem" />
                <FlareText Typo="TypographyScale.TitleMedium" Weight="FontWeight.Bold" Mono="true">weir</FlareText>
            </FlareStack>
            @* Shrinks and scrolls sideways in a narrow bar, so the language picker and the account menu stay on
               screen on a phone. FlareLinkTabs has no overflow mode of its own (unlike FlareTabs). *@
            <FlareLinkTabs Style="flex:1 1 auto;min-width:0;overflow-x:auto;scrollbar-width:none;">
                <FlareLinkTab Href="/" Match="NavMatchMode.Exact" Label="@AdminStrings.Nav_Dashboard" />
                <FlareLinkTab Href="/endpoints" Label="@AdminStrings.Nav_Endpoints" />
                <FlareLinkTab Href="/scopes" Label="@AdminStrings.Nav_Scopes" />
                <FlareLinkTab Href="/keys" Label="@AdminStrings.Nav_Keys" />
                <FlareLinkTab Href="/admins" Label="@AdminStrings.Nav_Admins" />
                <FlareLinkTab Href="/logs" Label="@AdminStrings.Nav_Logs" />
                <FlareLinkTab Href="/audit" Label="@AdminStrings.Nav_Audit" />
                <FlareLinkTab Href="/settings" Label="@AdminStrings.Nav_Settings" />
            </FlareLinkTabs>
            <FlareSpacer />
            @* Session-expiry warning: the access token is refreshed reactively on a 401, so this only tells
               the user their session is about to lapse rather than letting an expiry surprise them. *@
            @if (_expiresInMinutes is { } minutesLeft)
            {
                <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                    <FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Color="FlareColor.Warning" Size="1rem" />
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.Warning">@string.Format(AdminStrings.Layout_SessionExpiringSoon, minutesLeft)</FlareText>
                </FlareStack>
            }
            @* UI language picker, then the source-repository link, then the account menu. *@
            <LanguageSwitcher />
            <FlareIconButton Href="https://github.com/jrfrigat/weir" Target="_blank"
                             AriaLabel="@AdminStrings.Layout_GitHubAriaLabel" Size="ButtonSize.Sm">
                <GitHubIcon Size="1.15rem" />
            </FlareIconButton>
            <AuthorizeView>
                <Authorized>
                    @* FlareMenu's Activator is a typed slot (Flare 0.39+): its context carries the ARIA attributes
                       the activator element has to spread, and its implicit name clashes with the enclosing
                       AuthorizeView's, so it is named here and `context` stays the AuthenticationState. *@
                    <FlareMenu Anchor="MenuAnchor.BottomRight" AriaLabel="@AdminStrings.Layout_AccountMenuAriaLabel">
                        <Activator Context="menu">
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" @attributes="menu.Attributes">
                                <ChildContent>@context.User.Identity?.Name</ChildContent>
                                <TrailingIcon><FlareIconView Value="@FlareIcons.ExpandMore" Size="1.05rem" /></TrailingIcon>
                            </FlareButton>
                        </Activator>
                        <ChildContent>
                            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.AccountCircle" Href="/account">@AdminStrings.Layout_Account</FlareMenuItem>
                            <FlareMenuItem Icon="@MaterialDesign3Icons.Regular.Logout" OnClick="LogoutAsync">@AdminStrings.Layout_SignOut</FlareMenuItem>
                        </ChildContent>
                    </FlareMenu>
                </Authorized>
            </AuthorizeView>
        </FlareStack>
    </FlareLayoutAppBar>
    <FlareLayoutContent FillHeight="@_screenFit">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <FlareAlert Severity="AlertSeverity.Error" Title="@AdminStrings.Layout_ErrorTitle">
                    @AdminStrings.Layout_ErrorBody
                </FlareAlert>
            </ErrorContent>
        </ErrorBoundary>
    </FlareLayoutContent>
</FlareLayout>

@code {
    private ErrorBoundary? _errorBoundary;

    /// <summary>How often the access token's expiry is re-checked.</summary>
    private static readonly TimeSpan ExpiryCheckInterval = TimeSpan.FromSeconds(30);

    /// <summary>How long before expiry the warning appears.</summary>
    private const int ExpiryWarningMinutes = 2;

    private Timer? _expiryTimer;

    /// <summary>Whether the current page asked for a screen-fit content region.</summary>
    private bool _screenFit;

    /// <summary>Minutes left in the access token when it is close to expiry; null otherwise.</summary>
    private int? _expiresInMinutes;

    /// <summary>
    /// Recovers the error boundary on navigation so a per-page error clears when the user leaves it,
    /// and follows the UI language. A layout derives from LayoutComponentBase, so it cannot inherit
    /// LocalizedPage and subscribes to the language directly.
    /// </summary>
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Lang.LanguageChanged += OnLanguageChanged;
        ScreenFit.Changed += OnScreenFitChanged;
        _screenFit = ScreenFit.Enabled;
        _expiryTimer = new Timer(_ => _ = InvokeAsync(RefreshExpiryAsync), null, TimeSpan.Zero, ExpiryCheckInterval);
    }

    /// <summary>
    /// Handles route changes by clearing any caught error and resetting the screen-fit preference. The
    /// incoming page turns it back on after its first render if it wants one, so the two never race.
    /// </summary>
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _errorBoundary?.Recover();
        ScreenFit.Set(false);
    }

    /// <summary>Re-renders the shell when a page turns screen-fit on or off.</summary>
    private void OnScreenFitChanged()
    {
        _screenFit = ScreenFit.Enabled;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Re-renders the shell (nav labels, account menu) after a language switch.</summary>
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Reads the access token's expiry and raises (or clears) the app-bar warning when the session is
    /// close to lapsing. It only warns: the token is refreshed reactively on a 401, not by this timer.
    /// </summary>
    private async Task RefreshExpiryAsync()
    {
        int? minutesLeft = null;
        var token = await Tokens.GetAsync();
        if (!string.IsNullOrEmpty(token) &&
            JwtParser.ParseClaims(token, out var expires).Count > 0 &&
            expires is { } expiry)
        {
            var remaining = expiry - DateTimeOffset.UtcNow;
            if (remaining > TimeSpan.Zero && remaining <= TimeSpan.FromMinutes(ExpiryWarningMinutes))
            {
                minutesLeft = Math.Max(1, (int)Math.Ceiling(remaining.TotalMinutes));
            }
        }

        if (minutesLeft != _expiresInMinutes)
        {
            _expiresInMinutes = minutesLeft;
            StateHasChanged();
        }
    }

    /// <summary>Revokes the refresh token, clears both tokens, resets auth state and returns to login.</summary>
    private async Task LogoutAsync()
    {
        var refreshToken = await Tokens.GetRefreshAsync();
        await Api.LogoutAsync(refreshToken);
        await Tokens.ClearAllAsync();
        Auth.NotifyLogout();
        Navigation.NavigateTo("login");
    }

    /// <summary>Unsubscribes from navigation and language events and stops the expiry timer.</summary>
    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Lang.LanguageChanged -= OnLanguageChanged;
        ScreenFit.Changed -= OnScreenFitChanged;
        _expiryTimer?.Dispose();
    }
}
