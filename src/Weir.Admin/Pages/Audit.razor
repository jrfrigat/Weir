@page "/audit"
@attribute [Authorize]
@inherits LocalizedPage
@using Microsoft.AspNetCore.SignalR.Client
@inject WeirApiClient Api
@inject NavigationManager Nav
@inject TokenStore Tokens
@inject ISnackbarService Snackbar
@implements IAsyncDisposable

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@AdminStrings.Audit_Title" Description="@AdminStrings.Audit_Description" />

    @if (_entries is null)
    {
        <FlareText Color="FlareColor.OnSurfaceVariant">@AdminStrings.Common_Loading</FlareText>
    }
    else if (_entries.Count == 0)
    {
        <FlareEmptyState Title="@AdminStrings.Audit_EmptyTitle">
            <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.History" /></IconContent>
        </FlareEmptyState>
    }
    else
    {
        <FlareDataGrid Items="@_entries" Dense="true" Striped="true" Hoverable="true" FilterMode="DataGridFilterMode.Menu" PageSize="50" Height="auto">
            <ToolbarContent>
                <FlareDataGridQuickFilter Placeholder="@AdminStrings.Audit_FilterPlaceholder" />
            </ToolbarContent>
            <Columns>
                <FlareColumn TItem="AuditEntry" Id="time" Title="@AdminStrings.Audit_ColumnTime" Field="@(e => (object?)e.Timestamp.ToLocalTime().ToString("MM-dd HH:mm:ss"))" Sortable="true" />
                <FlareColumn TItem="AuditEntry" Id="category" Title="@AdminStrings.Audit_ColumnCategory" Field="@(e => (object?)e.Category)" Sortable="true" Filterable="true">
                    <Template>
                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.FiberManualRecord" Size="0.7rem" Color="@KindColor(context.Category)" />
                            <FlareText Element="span" Mono="true">@context.Category</FlareText>
                        </FlareStack>
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="AuditEntry" Id="actor" Title="@AdminStrings.Audit_ColumnActor" Field="@(e => (object?)e.Actor)" Sortable="true" Filterable="true" />
                <FlareColumn TItem="AuditEntry" Id="detail" Title="@AdminStrings.Audit_ColumnDetail" Field="@(e => (object?)(string.IsNullOrEmpty(e.Detail) ? e.Route : e.Detail))" Filterable="true" />
                <FlareColumn TItem="AuditEntry" Id="outcome" Title="@AdminStrings.Audit_ColumnOutcome" Filterable="true">
                    <Template>
                        <FlareText Element="span" Mono="true" Color="@OutcomeColor(context.Outcome)">@context.Outcome</FlareText>
                    </Template>
                </FlareColumn>
            </Columns>
        </FlareDataGrid>

        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
            @if (_hasMore)
            {
                <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="LoadOlderAsync" Disabled="_loadingMore">@AdminStrings.Audit_LoadOlder</FlareButton>
            }
            @if (_loadingMore)
            {
                <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Common_Loading</FlareText>
            }
            <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@string.Format(AdminStrings.Audit_EntriesLoaded, _entries.Count)</FlareText>
        </FlareStack>
    }
</FlareStack>

@code {
    private const int PageSize = 200;

    /// <summary>
    /// How many entries the page keeps in memory. The live feed prepends as events arrive, so without a cap
    /// a long-lived tab would grow forever; the tail is dropped, which leaves the "load older" cursor
    /// pointing at whatever is now the oldest row on screen.
    /// </summary>
    private const int MaxEntries = 2000;

    private List<AuditEntry>? _entries;
    private bool _hasMore;
    private bool _loadingMore;
    private HubConnection? _hub;
    private bool _disposed;

    /// <summary>Loads the most recent audit entries (first keyset page), then subscribes to the live feed.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entries = await Api.GetAuditAsync(PageSize);
            _hasMore = _entries is { Count: PageSize };
        }
        catch (HttpRequestException)
        {
            // An empty list rather than null: the page then draws its "nothing here" state next to the
            // error, instead of the loading spinner it would otherwise sit on forever.
            _entries = [];
            Snackbar.Show(AdminStrings.Common_LoadFailed, SnackbarSeverity.Error);
        }

        await ConnectHubAsync();
    }

    /// <summary>
    /// Subscribes to the dashboard hub's live audit feed. The page stays usable without it - the initial
    /// load and "load older" are plain HTTP - so a hub that cannot be reached costs the page its live
    /// updates and nothing else, which is why there is no polling fallback here.
    /// </summary>
    private async Task ConnectHubAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("hubs/dashboard"), options =>
                    options.AccessTokenProvider = () => Tokens.GetAsync().AsTask())
                .WithAutomaticReconnect()
                .Build();

            _hub.On<AuditEntry>("audit", entry => InvokeAsync(() =>
            {
                // The whole update happens on the UI thread: the callback arrives on the SignalR client's
                // thread, and the renderer reads this list while it draws.
                if (_disposed)
                {
                    return;
                }

                Prepend(entry);
                StateHasChanged();
            }));

            await _hub.StartAsync();
        }
        catch (Exception)
        {
            // The live feed is a convenience; the page remains readable from the page it already loaded.
        }
    }

    /// <summary>
    /// Puts one pushed entry at the top of the list. Entries are ordered by id descending, so an entry that
    /// is not newer than the newest row on screen has already been loaded and is dropped: that is the whole
    /// de-duplication, and it needs no id set.
    /// </summary>
    /// <param name="entry">The pushed entry.</param>
    private void Prepend(AuditEntry entry)
    {
        if (_entries is not { } entries)
        {
            // The first page has not arrived yet; the load already running will include this entry.
            return;
        }

        if (entries.Count > 0 && entry.Id <= entries[0].Id)
        {
            return;
        }

        entries.Insert(0, entry);
        if (entries.Count > MaxEntries)
        {
            entries.RemoveRange(MaxEntries, entries.Count - MaxEntries);
        }
    }

    /// <summary>Fetches the next older page using the last entry's id as the keyset cursor.</summary>
    private async Task LoadOlderAsync()
    {
        if (_entries is null || _entries.Count == 0)
        {
            return;
        }

        _loadingMore = true;
        try
        {
            var cursor = _entries[^1].Id;
            var older = await Api.GetAuditAsync(PageSize, cursor);
            if (older is { Count: > 0 })
            {
                _entries.AddRange(older);
            }

            _hasMore = older is { Count: PageSize };
        }
        catch (HttpRequestException)
        {
            Snackbar.Show(AdminStrings.Common_LoadFailed, SnackbarSeverity.Error);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    /// <summary>Maps an audit category to a kind-marker colour role.</summary>
    /// <param name="category">The audit category.</param>
    /// <returns>A Flare colour role.</returns>
    private static FlareColor KindColor(string? category)
    {
        var c = (category ?? string.Empty).ToLowerInvariant();
        if (c.Contains("login") || c.Contains("auth") || c.Contains("sign"))
        {
            return FlareColor.Info;
        }

        if (c.Contains("key"))
        {
            return FlareColor.Warning;
        }

        if (c.Contains("endpoint") || c.Contains("scope") || c.Contains("sync"))
        {
            return FlareColor.Success;
        }

        return FlareColor.OnSurfaceVariant;
    }

    /// <summary>Colours an outcome red when it denotes a failure, muted otherwise.</summary>
    /// <param name="outcome">The outcome text.</param>
    /// <returns>A Flare colour role.</returns>
    private static FlareColor OutcomeColor(string? outcome)
    {
        var o = (outcome ?? string.Empty).ToLowerInvariant();
        return o.Contains("den") || o.Contains("fail") || o.Contains("error") || o.Contains("403") || o.Contains("401")
            ? FlareColor.Error
            : FlareColor.OnSurfaceVariant;
    }

    /// <summary>Closes the hub connection when the page is navigated away from.</summary>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
