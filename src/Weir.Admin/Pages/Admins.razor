@page "/admins"
@using System.Globalization
@attribute [Authorize]
@inherits LocalizedPage
@inject WeirApiClient Api
@inject ISnackbarService Snackbar
@inject IDialogService Dialog
@inject AuthenticationStateProvider AuthState

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@AdminStrings.Admins_Title" Description="@AdminStrings.Admins_Description">
        <Actions>
            <FlareButton Variant="ButtonVariant.Filled" Color="FlareColor.Primary" Size="ButtonSize.Sm" OnClick="() => _showAdd = !_showAdd">@AdminStrings.Admins_NewAdmin</FlareButton>
        </Actions>
    </PageHeader>

    @if (_showAdd)
    {
        <FlareCard Variant="CardVariant.Outlined">
            <FlareStack Row Align="FlareAlignItems.End" Gap="FlareSpacing.Small" Wrap="true">
                <FlareField Label="@AdminStrings.Admins_Username" @bind-Value="_username" autocomplete="off" />
                <FlarePasswordField Label="@AdminStrings.Admins_Password" @bind-Value="_password" autocomplete="new-password" />
                <FlareSelect TValue="string" Label="@AdminStrings.Admins_Role" @bind-Value="_role" Items="_roles" ItemLabel="RoleLabel" />
                <FlareButton Variant="ButtonVariant.Filled" Color="FlareColor.Primary" OnClick="CreateAsync">@AdminStrings.Common_Create</FlareButton>
                @if (_createError is not null)
                {
                    <FlareAlert Severity="AlertSeverity.Error">@_createError</FlareAlert>
                }
            </FlareStack>
        </FlareCard>
    }

    @if (_admins is null)
    {
        <TableSkeleton Rows="5" />
    }
    else if (_admins.Count == 0)
    {
        <FlareEmptyState Title="@AdminStrings.Admins_EmptyTitle" Description="@AdminStrings.Admins_EmptyDescription">
            <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Group" /></IconContent>
            <ActionContent>
                <FlareButton Variant="ButtonVariant.Filled" Color="FlareColor.Primary" Size="ButtonSize.Sm" OnClick="() => _showAdd = true">@AdminStrings.Admins_NewAdmin</FlareButton>
            </ActionContent>
        </FlareEmptyState>
    }
    else
    {
        @if (_actionError is not null)
        {
            <FlareAlert Severity="AlertSeverity.Error" Title="@AdminStrings.Admins_ChangeRefusedTitle">@_actionError</FlareAlert>
        }

        <FlareDataGrid @ref="_grid" Items="@_admins" Dense="true" Striped="true" Hoverable="true" PageSize="50" Height="auto">
            <EmptyStateContent><NoMatchState OnClear="ClearFiltersAsync" /></EmptyStateContent>
            <Columns>
                <FlareColumn TItem="AdminUserInfo" Id="login" Title="@AdminStrings.Admins_Login" Field="@(a => (object?)a.Username)" Sortable="true" Filterable="true">
                    <Template>
                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareAvatar Size="AvatarSize.Sm">@Initials(context.Username)</FlareAvatar>
                            <FlareText Element="span" Mono="true">@context.Username</FlareText>
                        </FlareStack>
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="AdminUserInfo" Id="role" Title="@AdminStrings.Admins_Role">
                    <Template>
                        <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="@(context.Role == AdminRoles.Admin ? FlareColor.Primary : FlareColor.Default)" Label="@context.Role" />
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="AdminUserInfo" Id="status" Title="@AdminStrings.Admins_Status">
                    <Template>
                        <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="@(context.Enabled ? FlareColor.Success : FlareColor.Error)" Label="@(context.Enabled ? AdminStrings.Admins_StatusEnabled : AdminStrings.Admins_StatusDisabled)" />
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="AdminUserInfo" Id="last-login" Title="@AdminStrings.Admins_LastLogin" Field="@(a => (object?)(a.LastLoginAt.HasValue ? a.LastLoginAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-"))" Sortable="true" />
                <FlareColumn TItem="AdminUserInfo" Id="created" Title="@AdminStrings.Admins_Created" Field="@(a => (object?)a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd"))" Sortable="true" />
                <FlareColumn TItem="AdminUserInfo" Id="actions" Title="" Align="ColumnAlign.End">
                    <Template>
                        <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.End">
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => StartReset(context.Id))">@AdminStrings.Admins_ResetPassword</FlareButton>
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Disabled="_busyId == context.Id"
                                         OnClick="@(() => ToggleRoleAsync(context))">
                                @(context.Role == AdminRoles.Admin ? AdminStrings.Admins_MakeViewer : AdminStrings.Admins_MakeAdmin)
                            </FlareButton>
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Disabled="_busyId == context.Id"
                                         Color="@(context.Enabled ? FlareColor.Error : FlareColor.Success)"
                                         OnClick="@(() => ToggleEnabledAsync(context))">
                                @(context.Enabled ? AdminStrings.Admins_Disable : AdminStrings.Admins_Enable)
                            </FlareButton>
                        </FlareStack>
                    </Template>
                </FlareColumn>
            </Columns>
        </FlareDataGrid>

        @if (_resettingId is not null)
        {
            <FlareCard Variant="CardVariant.Outlined" Style="max-width:34rem;">
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareText Element="h2" Typo="TypographyScale.TitleSmall">@AdminStrings.Admins_ResetPassword</FlareText>
                    <FlarePasswordField Label="@AdminStrings.Admins_NewPassword" @bind-Value="_resetPassword" autocomplete="new-password" />
                    <FlareStack Row Gap="FlareSpacing.Small">
                        <FlareButton Variant="ButtonVariant.Filled" Color="FlareColor.Primary" OnClick="@(() => ResetAsync(_resettingId!.Value))" Loading="_resetBusy">@AdminStrings.Common_Save</FlareButton>
                        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => { _resettingId = null; })">@AdminStrings.Common_Cancel</FlareButton>
                    </FlareStack>
                    @if (_resetMessage is not null)
                    {
                        <FlareAlert Severity="AlertSeverity.Error">@_resetMessage</FlareAlert>
                    }
                </FlareStack>
            </FlareCard>
        }

        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
            @AdminStrings.Admins_RoleNotePrefix<FlareLink Href="/account">@AdminStrings.Admins_AccountLink</FlareLink>@AdminStrings.Admins_RoleNoteSuffix
        </FlareText>
    }
</FlareStack>

@code {
    private static readonly string[] _roles = [AdminRoles.Admin, AdminRoles.Viewer];

    private List<AdminUserInfo>? _admins;
    private bool _showAdd;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _role = AdminRoles.Admin;
    private string? _createError;
    private Guid? _resettingId;
    private string _resetPassword = string.Empty;
    private bool _resetBusy;
    private string? _resetMessage;
    private Guid? _busyId;
    private string? _actionError;
    private FlareDataGrid<AdminUserInfo>? _grid;
    private string? _currentUser;

    /// <summary>
    /// Clears the grid's column and quick filters, which are the only filters on this page, so the
    /// no-match state's button brings every account back.
    /// </summary>
    /// <returns>A task that completes once the grid has re-filtered.</returns>
    private Task ClearFiltersAsync() => _grid?.ClearAllFiltersAsync() ?? Task.CompletedTask;

    /// <summary>
    /// Loads the admin list and remembers who is signed in, so that disabling your own account can
    /// warn you about it before it happens rather than after.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _currentUser = (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name;
        await LoadAsync();
    }

    /// <summary>Reloads the admin list.</summary>
    private async Task LoadAsync() => _admins = await Api.GetAdminsAsync();

    /// <summary>Human-readable label for a role value in the selector.</summary>
    private static string RoleLabel(string role) => role == AdminRoles.Admin ? AdminStrings.Admins_RoleAdminFullAccess : AdminStrings.Admins_RoleViewerReadOnly;

    /// <summary>Creates an admin account and reloads.</summary>
    private async Task CreateAsync()
    {
        _createError = null;
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _createError = AdminStrings.Admins_EnterUsernameAndPassword;
            return;
        }

        try
        {
            await Api.CreateAdminAsync(new CreateAdminRequest { Username = _username, Password = _password, Role = _role });
        }
        catch (WeirApiException ex)
        {
            _createError = ex.Message;
            return;
        }

        _username = string.Empty;
        _password = string.Empty;
        _role = AdminRoles.Admin;
        _showAdd = false;
        Snackbar.Show(AdminStrings.Common_Saved, SnackbarSeverity.Success);
        await LoadAsync();
    }

    /// <summary>
    /// Flips an admin between Admin and Viewer, after asking. Confirmed for the same reason as
    /// enabling and disabling, one button along: the row is dense and the change is not one the
    /// clicker can undo alone. Taking the Admin role off your own account is called out separately -
    /// the console stays open, which is what makes it easy to miss that it has stopped working.
    /// </summary>
    /// <param name="admin">The admin whose role is changing.</param>
    /// <returns>A task that completes once the change has run, or the user has declined it.</returns>
    private async Task ToggleRoleAsync(AdminUserInfo admin)
    {
        var demoting = admin.Role == AdminRoles.Admin;
        var self = string.Equals(admin.Username, _currentUser, StringComparison.Ordinal);
        var body = demoting
            ? string.Format(
                CultureInfo.CurrentCulture,
                self ? AdminStrings.Admins_MakeViewerSelfConfirmBody : AdminStrings.Admins_MakeViewerConfirmBody,
                admin.Username)
            : string.Format(CultureInfo.CurrentCulture, AdminStrings.Admins_MakeAdminConfirmBody, admin.Username);

        var confirmed = await Dialog.ConfirmAsync(
            AdminStrings.Admins_RoleConfirmTitle,
            body,
            demoting ? AdminStrings.Admins_MakeViewer : AdminStrings.Admins_MakeAdmin,
            AdminStrings.Common_Cancel);
        if (confirmed != true)
        {
            return;
        }

        await RunAsync(admin.Id, () => Api.SetAdminRoleAsync(
            admin.Id, demoting ? AdminRoles.Viewer : AdminRoles.Admin));
    }

    /// <summary>
    /// Enables or disables an admin account, after asking. Both directions are confirmed, not just
    /// the destructive one: the buttons sit next to each other in a dense row, and a misclick either
    /// way changes who can get into the console. Disabling the account you are signed in with is
    /// called out separately, because it also ends the session you are reading the dialog in.
    /// </summary>
    /// <param name="admin">The admin being enabled or disabled.</param>
    /// <returns>A task that completes once the change has run, or the user has declined it.</returns>
    private async Task ToggleEnabledAsync(AdminUserInfo admin)
    {
        var disabling = admin.Enabled;
        var self = string.Equals(admin.Username, _currentUser, StringComparison.Ordinal);
        var body = disabling
            ? string.Format(
                CultureInfo.CurrentCulture,
                self ? AdminStrings.Admins_DisableSelfConfirmBody : AdminStrings.Admins_DisableConfirmBody,
                admin.Username)
            : string.Format(CultureInfo.CurrentCulture, AdminStrings.Admins_EnableConfirmBody, admin.Username);

        var confirmed = await Dialog.ConfirmAsync(
            disabling ? AdminStrings.Admins_DisableConfirmTitle : AdminStrings.Admins_EnableConfirmTitle,
            body,
            disabling ? AdminStrings.Admins_Disable : AdminStrings.Admins_Enable,
            AdminStrings.Common_Cancel);
        if (confirmed != true)
        {
            return;
        }

        await RunAsync(admin.Id, () => Api.SetAdminEnabledAsync(admin.Id, !admin.Enabled));
    }

    /// <summary>
    /// Runs one admin change, showing the server's reason when it refuses. The server declines a change
    /// that would leave nobody able to administer the control plane, and saying so is the point - the
    /// alternative is a button that silently does nothing.
    /// </summary>
    /// <param name="id">The admin being changed, held busy while the call runs.</param>
    /// <param name="call">The call to make.</param>
    private async Task RunAsync(Guid id, Func<Task<string?>> call)
    {
        _actionError = null;
        _busyId = id;
        try
        {
            _actionError = await call();
            if (_actionError is null)
            {
                Snackbar.Show(AdminStrings.Common_Saved, SnackbarSeverity.Success);
            }
        }
        finally
        {
            _busyId = null;
        }

        await LoadAsync();
    }

    /// <summary>Opens the inline password-reset panel for an admin.</summary>
    private void StartReset(Guid id)
    {
        _resettingId = id;
        _resetPassword = string.Empty;
        _resetMessage = null;
    }

    /// <summary>Resets an admin's password.</summary>
    private async Task ResetAsync(Guid id)
    {
        _resetMessage = null;
        if (string.IsNullOrWhiteSpace(_resetPassword))
        {
            _resetMessage = AdminStrings.Admins_EnterNewPassword;
            return;
        }

        _resetBusy = true;
        var ok = await Api.ResetAdminPasswordAsync(id, _resetPassword);
        _resetBusy = false;

        if (ok)
        {
            _resettingId = null;
            _resetPassword = string.Empty;
            Snackbar.Show(AdminStrings.Admins_PasswordReset, SnackbarSeverity.Success);
        }
        else
        {
            _resetMessage = AdminStrings.Admins_ResetFailedAdminRoleRequired;
        }
    }

    /// <summary>Two-letter uppercase initials from a username, for the avatar.</summary>
    /// <param name="name">The username.</param>
    /// <returns>Up to two uppercase letters, or "?" when unavailable.</returns>
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var letters = new string(name.Where(char.IsLetter).ToArray());
        return letters.Length == 0 ? "?" : letters[..Math.Min(2, letters.Length)].ToUpperInvariant();
    }
}
