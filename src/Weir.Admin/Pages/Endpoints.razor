@page "/endpoints"
@attribute [Authorize]
@using System.Globalization
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@inherits LocalizedPage
@inject WeirApiClient Api
@inject IDialogService Dialog
@inject NavigationManager Nav
@inject IFlareDownload Download
@inject ISnackbarService Snackbar

<FlareStack Gap="FlareSpacing.Medium">
    <PageHeader Title="@AdminStrings.Endpoints_PageTitle" Description="@AdminStrings.Endpoints_PageDescription">
        <Actions>
            <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="SyncAllAsync" Loading="_syncBusy">@AdminStrings.Endpoints_SyncAllButton</FlareButton>
            <FlareFileUploadButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" Accept=".json" Text="@AdminStrings.Endpoints_ImportButton" OnFilesChanged="ImportFilesAsync" />
            <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="ExportAsync">@AdminStrings.Endpoints_ExportButton</FlareButton>
            <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="BuildOpenApiAsync" Loading="_openApiBusy">OpenAPI</FlareButton>
            <FlareButton Variant="ButtonVariant.Filled" Color="FlareColor.Primary" Size="ButtonSize.Sm" OnClick="NewEndpoint">@AdminStrings.Endpoints_NewEndpoint</FlareButton>
        </Actions>
    </PageHeader>

    @if (_notice is not null)
    {
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@_notice</FlareText>
    }

    @if (_deleteError is not null)
    {
        <FlareAlert Severity="AlertSeverity.Error" Title="@AdminStrings.Common_ActionFailed">@_deleteError</FlareAlert>
    }

    <FlareTabs ActiveIndex="_epTabIndex" ActiveIndexChanged="OnTabChangedAsync">
        <FlareTab Label="@AdminStrings.Endpoints_TabEndpoints">
            @if (_endpoints is null)
            {
                <FlareText Color="FlareColor.OnSurfaceVariant">@AdminStrings.Common_Loading</FlareText>
            }
            else if (_endpoints.Count == 0)
            {
                <FlareEmptyState Title="@AdminStrings.Endpoints_EmptyTitle" Description="@AdminStrings.Endpoints_EmptyDescription">
                    <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Api" /></IconContent>
                </FlareEmptyState>
            }
            else
            {
                <FlareStack Row Align="FlareAlignItems.End" Gap="FlareSpacing.Small" Wrap="true">
                    <FlareText Typo="TypographyScale.LabelMedium" Mono="true" Color="FlareColor.OnSurfaceVariant" Style="letter-spacing:.1em;align-self:center;">@AdminStrings.Endpoints_FilterSectionHeader</FlareText>
                    <FlareSelect TValue="string" Label="@AdminStrings.Endpoints_FilterScopeLabel" Size="FieldSize.Sm" Value="_filterScope" ValueChanged="OnFilterScopeChanged" Items="ScopeFilterOptions" ItemLabel="ScopeFilterLabel" Style="min-width:12rem;" />
                    <FlareSelect TValue="string" Label="@AdminStrings.Endpoints_FilterKeyLabel" Size="FieldSize.Sm" Value="_filterKeyId" ValueChanged="OnFilterKeyChanged" Items="KeyFilterOptions" ItemLabel="KeyFilterLabel" Style="min-width:14rem;" />
                    @if (IsFiltered)
                    {
                        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant" Style="align-self:center;">@string.Format(AdminStrings.Endpoints_FilterSummary, FilteredEndpoints.Count, _endpoints.Count)</FlareText>
                        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ClearFilters">@AdminStrings.Endpoints_ClearFilters</FlareButton>
                    }
                </FlareStack>
                <FlareDataGrid Items="@FilteredEndpoints" Dense="true" Striped="true" Hoverable="true" FilterMode="DataGridFilterMode.Menu" PageSize="50" Height="auto">
                    <ToolbarContent><FlareDataGridQuickFilter Placeholder="@AdminStrings.Endpoints_QuickFilterPlaceholder" /></ToolbarContent>
                    <Columns>
                        <FlareColumn TItem="EndpointDefinition" Id="status" Title="@AdminStrings.Endpoints_StatusColumn">
                            <Template><FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="@(context.Enabled ? FlareColor.Success : FlareColor.Default)" Label="@(context.Enabled ? AdminStrings.Common_Enabled : AdminStrings.Endpoints_StatusDisabled)" /></Template>
                        </FlareColumn>
                        <FlareColumn TItem="EndpointDefinition" Id="method" Title="@AdminStrings.Endpoints_MethodLabel" Field="@(e => (object?)e.HttpMethod)" Sortable="true">
                            <Template><FlareText Element="span" Mono="true" Weight="FontWeight.Bold" Color="@MethodColor(context.HttpMethod)">@context.HttpMethod</FlareText></Template>
                        </FlareColumn>
                        <FlareColumn TItem="EndpointDefinition" Id="route" Title="@AdminStrings.Endpoints_RouteLabel" Field="@(e => (object?)e.Route)" Sortable="true" Filterable="true">
                            <Template><FlareText Element="span" Mono="true">/api/@context.Route</FlareText></Template>
                        </FlareColumn>
                        <FlareColumn TItem="EndpointDefinition" Id="connection" Title="@AdminStrings.Endpoints_ConnectionLabel" Field="@(e => (object?)e.ConnectionName)" Sortable="true" Filterable="true" />
                        <FlareColumn TItem="EndpointDefinition" Id="object" Title="@AdminStrings.Endpoints_ObjectLabel" Field="@(e => (object?)(e.Schema + "." + e.ObjectName))" Sortable="true" Filterable="true" />
                        <FlareColumn TItem="EndpointDefinition" Id="type" Title="@AdminStrings.Endpoints_TypeColumn" Field="@(e => (object?)ObjectTypeLabel(e.ObjectType))" Sortable="true" />
                        <FlareColumn TItem="EndpointDefinition" Id="params" Title="@AdminStrings.Endpoints_ParamsColumn" Field="@(e => (object?)e.Parameters.Count)" Align="ColumnAlign.End" />
                        <FlareColumn TItem="EndpointDefinition" Id="actions" Title="@AdminStrings.Common_Actions" Align="ColumnAlign.End">
                            <Template>
                                <FlareStack Row Gap="FlareSpacing.XSmall" Justify="FlareJustifyContent.End">
                                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Color="FlareColor.Primary" OnClick="@(() => StartTest(context))">@AdminStrings.Endpoints_Test</FlareButton>
                                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => OpenLogs(context))">@AdminStrings.Endpoints_LogsButton</FlareButton>
                                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => Edit(context))">@AdminStrings.Common_Edit</FlareButton>
                                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => SyncOneAsync(context.Id))">@AdminStrings.Endpoints_SyncButton</FlareButton>
                                    @if (context.Cache.Enabled)
                                    {
                                        <FlareTooltip Content="@AdminStrings.Endpoints_PurgeCacheTooltip" Arrow="true">
                                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => PurgeCacheAsync(context))">@AdminStrings.Endpoints_PurgeCacheButton</FlareButton>
                                        </FlareTooltip>
                                    }
                                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Color="FlareColor.Error" OnClick="@(() => DeleteAsync(context))">@AdminStrings.Common_Delete</FlareButton>
                                </FlareStack>
                            </Template>
                        </FlareColumn>
                    </Columns>
                </FlareDataGrid>
            }
        </FlareTab>
        <FlareTab Label="@AdminStrings.Endpoints_TabDatabase">
            <FlareStack Gap="FlareSpacing.Small">
                <FlareStack Row Align="FlareAlignItems.End" Gap="FlareSpacing.Small">
                    <FlareSelect TValue="string" Label="@AdminStrings.Endpoints_ConnectionLabel" Value="_dbConnection" ValueChanged="SetDbConnectionAsync" Items="@ConnectionNames" ItemLabel="ProviderLabel" />
                    <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="OnConnectionChangedAsync">@AdminStrings.Common_Refresh</FlareButton>
                </FlareStack>
                @if (_objectsError is not null)
                {
                    <FlareAlert Severity="AlertSeverity.Warning">@string.Format(AdminStrings.Endpoints_ObjectsNotBrowsable, _objectsError)</FlareAlert>
                }
                <FlareStack Row Gap="FlareSpacing.Medium" Align="FlareAlignItems.Start" Wrap="true">
                    <div style="flex:2 1 26rem;min-width:0;">
                        @if (_objects is null)
                        {
                            <FlareText Color="FlareColor.OnSurfaceVariant">@AdminStrings.Common_Loading</FlareText>
                        }
                        else if (_objects.Count == 0)
                        {
                            <FlareText Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_NoObjectsFound</FlareText>
                        }
                        else
                        {
                            <FlareDataGrid TItem="DbObjectDescriptor" Items="@_objects" Dense="true" Striped="true" Hoverable="true" PageSize="50" Height="auto" RowClick="OnObjectRowClick">
                                <Columns>
                                    <FlareColumn TItem="DbObjectDescriptor" Id="object-schema" Title="@AdminStrings.Endpoints_SchemaLabel" Field="@(o => (object?)o.Schema)" Sortable="true" Filterable="true" />
                                    <FlareColumn TItem="DbObjectDescriptor" Id="object-name" Title="@AdminStrings.Endpoints_ObjectLabel" Field="@(o => (object?)o.Name)" Sortable="true" Filterable="true">
                                        <Template><FlareText Element="span" Mono="true">@context.Name</FlareText></Template>
                                    </FlareColumn>
                                    <FlareColumn TItem="DbObjectDescriptor" Id="object-type" Title="@AdminStrings.Endpoints_TypeColumn" Field="@(o => (object?)ObjectTypeLabel(o.ObjectType))" Sortable="true" />
                                    <FlareColumn TItem="DbObjectDescriptor" Id="object-endpoint" Title="@AdminStrings.Endpoints_EndpointColumn" Align="ColumnAlign.End">
                                        <Template>
                                            @{
                                                var mapped = EndpointsForObject(context.Schema, context.Name);
                                            }
                                            @if (mapped.Count == 0)
                                            {
                                                <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Outlined" Color="FlareColor.Default" Label="@AdminStrings.Endpoints_NoneChip" />
                                            }
                                            else
                                            {
                                                <FlareStack Row Gap="FlareSpacing.XSmall" Justify="FlareJustifyContent.End" Wrap="true">
                                                    @foreach (var mappedEndpoint in mapped)
                                                    {
                                                        <FlareTooltip Content="@($"{mappedEndpoint.HttpMethod} /api/{mappedEndpoint.Route}")" Arrow="true">
                                                            <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Success" OnClick="@(() => Edit(mappedEndpoint))">
                                                                <FlareText Element="span" Mono="true" Weight="FontWeight.Bold" Color="@MethodColor(mappedEndpoint.HttpMethod)">@mappedEndpoint.HttpMethod</FlareText>
                                                                <FlareText Element="span" Mono="true">&nbsp;/@mappedEndpoint.Route</FlareText>
                                                            </FlareChip>
                                                        </FlareTooltip>
                                                    }
                                                </FlareStack>
                                            }
                                        </Template>
                                    </FlareColumn>
                                </Columns>
                            </FlareDataGrid>
                        }
                    </div>
                    <FlareCard Variant="CardVariant.Outlined" Style="flex:1 1 20rem;min-width:18rem;">
                        @if (_selectedObject is null)
                        {
                            <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodySmall">@AdminStrings.Endpoints_SelectObjectHint</FlareText>
                        }
                        else
                        {
                            <FlareStack Gap="FlareSpacing.Small">
                                <div>
                                    <FlareText Mono="true">@_selectedObject.Schema.@_selectedObject.Name</FlareText>
                                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant" Mono="true">@string.Format(AdminStrings.Endpoints_ObjectSummary, ObjectTypeLabel(_selectedObject.ObjectType), _selectedParameters?.Count ?? 0)</FlareText>
                                </div>
                                @if (_selectedParameters is null)
                                {
                                    <FlareText Color="FlareColor.OnSurfaceVariant">@AdminStrings.Common_Loading</FlareText>
                                }
                                else
                                {
                                    <FlareDescriptionList>
                                        @foreach (var parameter in _selectedParameters)
                                        {
                                            <FlareDescriptionItem>
                                                <LabelContent>
                                                    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                                        <FlareText Element="span" Mono="true">@parameter.Name</FlareText>
                                                        <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Outlined" Label="@parameter.Direction.ToString()" />
                                                    </FlareStack>
                                                </LabelContent>
                                                <ChildContent><FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">@TypeLabel(parameter.DbType, parameter.TypeName, parameter.Size)</FlareText></ChildContent>
                                            </FlareDescriptionItem>
                                        }
                                    </FlareDescriptionList>
                                }
                                <FlareButton Variant="ButtonVariant.Filled" Color="FlareColor.Primary" FullWidth="true" OnClick="@(() => CreateFromObjectAsync(_selectedObject))">@AdminStrings.Endpoints_CreateFromObject</FlareButton>
                            </FlareStack>
                        }
                    </FlareCard>
                </FlareStack>
            </FlareStack>
        </FlareTab>
    </FlareTabs>
</FlareStack>

@* ===== Editor drawer ===== *@
<FlareDrawer Open="@(_editing is not null)" OpenChanged="@(open => { if (!open) CancelEdit(); })" Anchor="DrawerAnchor.Right" Width="44rem" ContentPadding="FlareSpacing.Large" Variant="DrawerVariant.Temporary">
    <HeaderContent><FlareText Typo="TypographyScale.TitleMedium">@(_editing is { Id: var id } && id != Guid.Empty ? AdminStrings.Endpoints_EditEndpoint : AdminStrings.Endpoints_NewEndpoint)</FlareText></HeaderContent>
    <ChildContent>
        @if (_editing is not null)
        {
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareGrid Columns="2" Gap="FlareSpacing.Small">
                    <FlareCol Span="1"><FlareSelect TValue="string" Label="@AdminStrings.Endpoints_MethodLabel" Size="FieldSize.Sm" @bind-Value="_editing.HttpMethod" Items="_methods" /></FlareCol>
                    <FlareCol Span="1"><FlareField Label="@AdminStrings.Endpoints_RouteLabel" Size="FieldSize.Sm" @bind-Value="_editing.Route" Placeholder="orders/create" /></FlareCol>
                    <FlareCol Span="1"><FlareSelect TValue="string" Label="@AdminStrings.Endpoints_ConnectionLabel" Size="FieldSize.Sm" @bind-Value="_editing.ConnectionName" Items="@ConnectionNames" /></FlareCol>
                    <FlareCol Span="1"><FlareSelect TValue="EndpointOperation" Label="@AdminStrings.Endpoints_OperationLabel" Size="FieldSize.Sm" Value="_editing.Operation" ValueChanged="OperationChanged" Items="Enum.GetValues<EndpointOperation>()" ItemLabel="@(v => OperationLabel(v))" /></FlareCol>
                    <FlareCol Span="1"><FlareSelect TValue="DbObjectType" Label="@AdminStrings.Endpoints_ObjectTypeLabel" Size="FieldSize.Sm" @bind-Value="_editing.ObjectType" Items="ObjectTypesFor(_editing.Operation)" ItemLabel="@(v => ObjectTypeLabel(v))" /></FlareCol>
                    <FlareCol Span="1"><FlareField Label="@AdminStrings.Endpoints_SchemaLabel" Size="FieldSize.Sm" @bind-Value="_editing.Schema" /></FlareCol>
                    <FlareCol Span="1"><FlareField Label="@AdminStrings.Endpoints_ObjectLabel" Size="FieldSize.Sm" @bind-Value="_editing.ObjectName" Placeholder="usp_CreateOrder" /></FlareCol>
                    <FlareCol Span="1"><FlareSelect TValue="ResultMode" Label="@AdminStrings.Endpoints_ResultModeLabel" Size="FieldSize.Sm" @bind-Value="_editing.ResultMode" Items="Enum.GetValues<ResultMode>()" ItemLabel="@(v => v.ToString())" /></FlareCol>
                    <FlareCol Span="1"><FlareNumericField TValue="int?" Label="@AdminStrings.Endpoints_TimeoutLabel" Size="FieldSize.Sm" @bind-Value="_editing.CommandTimeoutSeconds" HelperText="@DurationHint.Humanize(_editing.CommandTimeoutSeconds)" /></FlareCol>
                </FlareGrid>

                <FlareStack Row Gap="FlareSpacing.Large" Wrap="true">
                    <FlareSwitch Value="_editing.Enabled" ValueChanged="@(v => _editing.Enabled = v)" Label="@AdminStrings.Common_Enabled" />
                    <FlareSwitch Value="_editing.SuppressMessages" ValueChanged="@(v => _editing.SuppressMessages = v)" Label="@AdminStrings.Endpoints_SuppressMessagesLabel" />
                </FlareStack>

                <FlareDivider Text="@AdminStrings.Endpoints_DeliverySection" TextAlign="DividerTextAlign.Left" />
                <FlareStack Row Gap="FlareSpacing.Large" Wrap="true" Align="FlareAlignItems.Center">
                    <FlareSelect TValue="string" Label="@AdminStrings.Endpoints_DeliveryModeLabel" Size="FieldSize.Sm"
                                 @bind-Value="_editing.DeliveryMode" Items="DeliveryModeOptions" ItemLabel="DeliveryModeLabel"
                                 Style="min-width:14rem;" />
                    <FlareNumericField TValue="int?" Label="@AdminStrings.Endpoints_DeliveryFlushBytesLabel" Size="FieldSize.Sm"
                                       @bind-Value="_editing.DeliveryFlushBytes" Style="max-width:11rem;" />
                    <FlareSelect TValue="string" Label="@AdminStrings.Endpoints_CompressionModeLabel" Size="FieldSize.Sm"
                                 @bind-Value="_editing.CompressionMode" Items="CompressionModeOptions" ItemLabel="CompressionModeLabel"
                                 Style="min-width:14rem;" />
                </FlareStack>
                <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_DeliveryHelp</FlareText>
                @if (_editing.DeliveryFlushBytes >= LargeObjectHeapThresholdBytes)
                {
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.Warning">@AdminStrings.Common_FlushBytesLohWarning</FlareText>
                }
                else if (_editing.DeliveryFlushBytes is > 0 and < MinSensibleFlushBytes)
                {
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.Warning">@AdminStrings.Common_FlushBytesTinyWarning</FlareText>
                }
                @if (_editing.CacheEnabled || _editing.LogResult)
                {
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.Warning">@AdminStrings.Endpoints_DeliveryForcedHelp</FlareText>
                }

                <FlareDivider Text="@AdminStrings.Endpoints_CachingSection" TextAlign="DividerTextAlign.Left" />
                <FlareStack Row Gap="FlareSpacing.Large" Wrap="true" Align="FlareAlignItems.Center">
                    <FlareSwitch Value="_editing.CacheEnabled" ValueChanged="@(v => _editing.CacheEnabled = v)" Label="@AdminStrings.Endpoints_EnableCacheLabel" />
                    <FlareNumericField TValue="int" Label="@AdminStrings.Endpoints_CacheTtlLabel" Size="FieldSize.Sm" @bind-Value="_editing.CacheTtlSeconds" HelperText="@DurationHint.Humanize(_editing.CacheTtlSeconds)" Style="max-width:9rem;" />
                    <FlareSwitch Value="_editing.CacheVaryByApiKey" ValueChanged="@(v => _editing.CacheVaryByApiKey = v)" Label="@AdminStrings.Endpoints_CacheVaryByApiKeyLabel" />
                    <FlareSwitch Value="_editing.CacheCoalesceRequests" ValueChanged="@(v => _editing.CacheCoalesceRequests = v)" Label="@AdminStrings.Endpoints_CacheCoalesceLabel" />
                </FlareStack>
                @if (_editing.CacheEnabled)
                {
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_CacheCoalesceHelp</FlareText>
                }
                @if (_editing.CacheEnabled)
                {
                    <div>
                        <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_CacheVaryByParams</FlareText>
                        @if (_editing.Parameters.Count == 0)
                        {
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_CacheNoParameters</FlareText>
                        }
                        else
                        {
                            <FlareStack Row Wrap="true" Gap="FlareSpacing.XSmall">
                                @foreach (var parameter in _editing.Parameters)
                                {
                                    var on = _editing.CacheVaryBy.Contains(parameter.Name);
                                    <FlareChip Size="ChipSize.Sm" Label="@parameter.Name"
                                               Variant="@(on ? ChipVariant.Filled : ChipVariant.Outlined)"
                                               Color="@(on ? FlareColor.Primary : FlareColor.Default)"
                                               OnClick="@(() => ToggleCacheVary(parameter.Name, !on))" />
                                }
                            </FlareStack>
                        }
                        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_CacheVaryHelp</FlareText>
                    </div>
                }

                <FlareDivider Text="@AdminStrings.Endpoints_LoggingSection" TextAlign="DividerTextAlign.Left" />
                <FlareStack Row Gap="FlareSpacing.Large" Wrap="true" Align="FlareAlignItems.Center">
                    <FlareSwitch Value="_editing.LogEnabled" ValueChanged="@(v => _editing.LogEnabled = v)" Label="@AdminStrings.Endpoints_LogRequestsLabel" />
                    <FlareSwitch Value="_editing.LogParameters" ValueChanged="@(v => _editing.LogParameters = v)" Label="@AdminStrings.Endpoints_LogParametersLabel" />
                    <FlareSwitch Value="_editing.LogResult" ValueChanged="@(v => _editing.LogResult = v)" Label="@AdminStrings.Endpoints_LogResultLabel" />
                    <FlareNumericField TValue="int?" Label="@AdminStrings.Endpoints_SlowThresholdLabel" Size="FieldSize.Sm" @bind-Value="_editing.SlowThresholdPercent" Placeholder="@AdminStrings.Endpoints_SlowThresholdPlaceholder" Style="max-width:12rem;" />
                </FlareStack>
                <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_LoggingHelp</FlareText>

                <div>
                    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_RequiredScopes</FlareText>
                    @if (_scopes is null || _scopes.Count == 0)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_NoScopesDefined</FlareText>
                    }
                    else
                    {
                        <FlareStack Row Wrap="true" Gap="FlareSpacing.XSmall">
                            @foreach (var scope in _scopes)
                            {
                                var selected = _editing.Scopes.Contains(scope.Name);
                                <FlareChip Size="ChipSize.Sm" Label="@scope.Name" Variant="@(selected ? ChipVariant.Filled : ChipVariant.Outlined)" Color="@(selected ? FlareColor.Primary : FlareColor.Default)" OnClick="@(() => ToggleScope(scope.Name, !selected))" />
                            }
                        </FlareStack>
                    }
                </div>

                @if (_editing.Operation == EndpointOperation.Invoke)
                {
                <FlareDivider Text="@AdminStrings.Endpoints_ParametersSection" TextAlign="DividerTextAlign.Left" />
                <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                    <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="DiscoverParametersAsync" Loading="_discovering">@AdminStrings.Endpoints_DiscoverParameters</FlareButton>
                    @if (_discoverError is not null)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@_discoverError</FlareText>
                    }
                </FlareStack>
                @foreach (var parameter in _editing.Parameters)
                {
                    <FlareCard Variant="CardVariant.Outlined" Compact="true">
                        <FlareStack Gap="FlareSpacing.XSmall">
                            <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.End" Wrap="true">
                                <FlareField TValue="string" Label="@AdminStrings.Endpoints_ParamNameLabel" Placeholder="@AdminStrings.Endpoints_ParamNamePlaceholder" Size="FieldSize.Sm" @bind-Value="parameter.Name" Style="min-width:9rem;" />
                                <FlareSelect TValue="ParameterSource" Label="@AdminStrings.Endpoints_ParamSourceLabel" Size="FieldSize.Sm" @bind-Value="parameter.Source" Items="Enum.GetValues<ParameterSource>()" ItemLabel="@(v => v.ToString())" Style="min-width:7rem;" />
                                <FlareSelect TValue="Weir.Contracts.ParameterDirection" Label="@AdminStrings.Endpoints_ParamDirectionLabel" Size="FieldSize.Sm" @bind-Value="parameter.Direction" Items="Enum.GetValues<Weir.Contracts.ParameterDirection>()" ItemLabel="@(v => v.ToString())" Style="min-width:8rem;" />
                                <FlareSelect TValue="WeirDbType" Label="@AdminStrings.Endpoints_ParamTypeLabel" Size="FieldSize.Sm" @bind-Value="parameter.DbType" Items="Enum.GetValues<WeirDbType>()" ItemLabel="@(v => v.ToString())" Style="min-width:8rem;" />
                                <FlareNumericField TValue="int?" Label="@AdminStrings.Endpoints_ParamSizeLabel" Placeholder="@AdminStrings.Endpoints_ParamSizePlaceholder" Size="FieldSize.Sm" @bind-Value="parameter.Size" Style="max-width:6rem;" />
                                <FlareSwitch Value="parameter.Required" ValueChanged="@(v => parameter.Required = v)" Label="@AdminStrings.Endpoints_ParamRequiredLabel" />
                                <FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Error" Size="ButtonSize.Sm" OnClick="@(() => RemoveParameter(parameter))">@AdminStrings.Common_Remove</FlareButton>
                            </FlareStack>
                            @if (parameter.DbType == WeirDbType.Structured)
                            {
                                <FlareField TValue="string" Placeholder="@AdminStrings.Endpoints_TvpTypePlaceholder" Size="FieldSize.Sm" @bind-Value="parameter.TypeName" />
                                @foreach (var column in parameter.Columns)
                                {
                                    <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                                        <FlareField TValue="string" Placeholder="@AdminStrings.Endpoints_ColumnPlaceholder" Size="FieldSize.Sm" @bind-Value="column.Name" />
                                        <FlareSelect TValue="WeirDbType" Size="FieldSize.Sm" @bind-Value="column.DbType" Items="Enum.GetValues<WeirDbType>()" ItemLabel="@(v => v.ToString())" />
                                        <FlareTooltip Content="@AdminStrings.Endpoints_RemoveColumnTooltip" Arrow="true">
                                            <FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Error" Size="ButtonSize.Sm" OnClick="@(() => RemoveColumn(parameter, column))">x</FlareButton>
                                        </FlareTooltip>
                                    </FlareStack>
                                }
                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => AddColumn(parameter))">@AdminStrings.Endpoints_AddColumn</FlareButton>
                            }
                        </FlareStack>
                    </FlareCard>
                }
                <FlareStack Row><FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="AddParameter">@AdminStrings.Endpoints_AddParameter</FlareButton></FlareStack>
                }

                @if (_editing.Operation != EndpointOperation.Invoke)
                {
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_OperationHelp</FlareText>
                    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap="true">
                        <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="LoadColumnsAsync" Loading="_loadingColumns">@AdminStrings.Endpoints_LoadColumns</FlareButton>
                        @if (_columnsError is not null)
                        {
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@_columnsError</FlareText>
                        }
                    </FlareStack>
                }

                @if (_editing.Operation == EndpointOperation.Dictionary)
                {
                    <FlareDivider Text="@AdminStrings.Endpoints_DictionarySection" TextAlign="DividerTextAlign.Left" />
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_DictionaryHelp</FlareText>

                    <div>
                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_DictionaryColumns</FlareText>
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => SetAllProjected(true))">@AdminStrings.Endpoints_SelectAll</FlareButton>
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => SetAllProjected(false))">@AdminStrings.Endpoints_SelectNone</FlareButton>
                        </FlareStack>
                        @if (KnownColumns.Count == 0)
                        {
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_ColumnsNoneFound</FlareText>
