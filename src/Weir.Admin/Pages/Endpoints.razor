                @if (_editing.Operation == EndpointOperation.Import)
                {
                    <FlareDivider Text="@AdminStrings.Endpoints_ImportSection" TextAlign="DividerTextAlign.Left" />
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_ImportHelp</FlareText>

                    <FlareStack Row Gap="FlareSpacing.Large" Wrap="true" Align="FlareAlignItems.End">
                        <FlareSelect TValue="ImportMode" Label="@AdminStrings.Endpoints_ImportMode" Size="FieldSize.Sm"
                                     @bind-Value="_editing.ImportMode" Items="Enum.GetValues<ImportMode>()" ItemLabel="@(v => ImportModeLabel(v))" Style="min-width:16rem;" />
                        <FlareField TValue="string" Label="@AdminStrings.Endpoints_ImportRowsProperty" Size="FieldSize.Sm"
                                    @bind-Value="_editing.ImportRowsProperty" Placeholder="rows" Style="max-width:10rem;" />
                        <FlareNumericField TValue="int" Label="@AdminStrings.Endpoints_ImportBatchSize" Size="FieldSize.Sm" @bind-Value="_editing.ImportBatchSize" Style="max-width:9rem;" />
                        <FlareNumericField TValue="int" Label="@AdminStrings.Endpoints_ImportMaxRows" Size="FieldSize.Sm" @bind-Value="_editing.ImportMaxRows" Style="max-width:9rem;" />
                        <FlareSwitch Value="_editing.ImportTransactional" ValueChanged="@(v => _editing.ImportTransactional = v)" Label="@AdminStrings.Endpoints_ImportTransactional" />
                    </FlareStack>
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_ImportRowsHelp @AdminStrings.Endpoints_ImportMaxRowsHelp @AdminStrings.Endpoints_ImportTransactionalHelp</FlareText>

                    @if (_editing.ImportMode == ImportMode.Upsert)
                    {
                        <div>
                            <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_ImportKeyColumns</FlareText>
                            <FlareStack Row Wrap="true" Gap="FlareSpacing.XSmall">
                                @foreach (var column in _editing.ImportColumns.Where(c => !string.IsNullOrWhiteSpace(c.Name)))
                                {
                                    var name = column.Name;
                                    var on = _editing.ImportKeyColumns.Contains(name, StringComparer.OrdinalIgnoreCase);
                                    <FlareChip Size="ChipSize.Sm" Label="@name"
                                               Variant="@(on ? ChipVariant.Filled : ChipVariant.Outlined)"
                                               Color="@(on ? FlareColor.Primary : FlareColor.Default)"
                                               OnClick="@(() => Toggle(_editing.ImportKeyColumns, name))" />
                                }
                            </FlareStack>
                            <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_ImportKeyHelp</FlareText>
