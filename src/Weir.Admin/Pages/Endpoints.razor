                    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_ImportColumns</FlareText>
                    @if (_editing.ImportColumns.Count == 0)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_ImportNoColumns</FlareText>
                    }
                    else
                    {
                        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_ImportGeneratedHint</FlareText>
                    }
                    @foreach (var column in _editing.ImportColumns)
                    {
                        <FlareCard Variant="CardVariant.Outlined" Compact="true">
                            <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.End" Wrap="true">
                                <FlareCombobox TValue="string" Label="@AdminStrings.Endpoints_FilterColumn" Size="FieldSize.Sm"
                                               @bind-Value="column.Name" Items="KnownColumns"
                                               AllowsCustomValue="true" CustomValueFactory="@(text => text)" Style="min-width:10rem;" />
                                <FlareField TValue="string" Label="@AdminStrings.Endpoints_ImportSourceProperty" Size="FieldSize.Sm"
                                            @bind-Value="column.SourceProperty" Placeholder="@column.Name" Style="min-width:9rem;" />
                                <FlareSelect TValue="WeirDbType" Label="@AdminStrings.Endpoints_ParamTypeLabel" Size="FieldSize.Sm"
                                             @bind-Value="column.DbType" Items="Enum.GetValues<WeirDbType>()" ItemLabel="@(v => v.ToString())" Style="min-width:8rem;" />
                                <FlareNumericField TValue="int?" Label="@AdminStrings.Endpoints_ParamSizeLabel" Size="FieldSize.Sm" @bind-Value="column.Size" Style="max-width:6rem;" />
                                <FlareSwitch Value="column.Required" ValueChanged="@(v => column.Required = v)" Label="@AdminStrings.Endpoints_ParamRequiredLabel" />
                                <FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Error" Size="ButtonSize.Sm" OnClick="@(() => _editing.ImportColumns.Remove(column))">@AdminStrings.Common_Remove</FlareButton>
                            </FlareStack>
                        </FlareCard>
                    }
                    <FlareStack Row><FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="AddImportColumn">@AdminStrings.Endpoints_AddColumn</FlareButton></FlareStack>
                }

                <FlareDivider />
                @if (_saveError is not null)
                {
                    <FlareAlert Severity="AlertSeverity.Error" Title="@AdminStrings.Common_ActionFailed">@_saveError</FlareAlert>
                }
                <FlareStack Row Gap="FlareSpacing.Small" Justify="FlareJustifyContent.End">
                    <FlareButton Variant="ButtonVariant.Text" OnClick="CancelEdit">@AdminStrings.Common_Cancel</FlareButton>
                    <FlareButton Variant="ButtonVariant.Filled" Color="FlareColor.Primary" OnClick="SaveAsync" Loading="_busy">@AdminStrings.Endpoints_SaveEndpoint</FlareButton>
                </FlareStack>
            </FlareStack>
        }
    </ChildContent>
</FlareDrawer>

@* ===== Test drawer ===== *@
<FlareDrawer Open="@(_testing is not null)" OpenChanged="@(open => { if (!open) CloseTest(); })" Anchor="DrawerAnchor.Right" Width="44rem" ContentPadding="FlareSpacing.Large" Variant="DrawerVariant.Temporary">
    <HeaderContent>
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
            <FlareText Typo="TypographyScale.TitleMedium">@AdminStrings.Endpoints_Test</FlareText>
            @if (_testing is not null)
            {
                <FlareText Element="span" Mono="true" Weight="FontWeight.Bold" Color="@MethodColor(_testing.HttpMethod)">@_testing.HttpMethod</FlareText>
                <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">/api/@_testing.Route</FlareText>
            }
        </FlareStack>
    </HeaderContent>
    <ChildContent>
        @if (_testing is not null)
        {
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween">
                    <FlareText Typo="TypographyScale.TitleSmall">@AdminStrings.Endpoints_ParametersSection</FlareText>
                    <FlareSwitch Value="_testRaw" ValueChanged="ToggleRaw" Label="@AdminStrings.Endpoints_RawJsonLabel" />
                </FlareStack>

                @if (_testRaw)
                {
                    <FlareCodeBlock Value="@_testRawBody" ValueChanged="OnRawBodyChanged" Language="json"
                                    ReadOnly="false" Rows="12" LineNumbers="true" MaxSuggestions="12"
                                    SuggestionProvider="@SuggestBodyKeys" Markers="@_testRawMarkers" />
                }
                else if (_testInputParameters.Count == 0)
                {
                    <FlareText Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_NoInputParameters</FlareText>
                }
                else
                {
                    @foreach (var parameter in _testInputParameters)
                    {
                        <FlareStack Gap="FlareSpacing.None">
                            @if (parameter.DbType == WeirDbType.Boolean)
                            {
                                <FlareCheckbox Label="@parameter.Name" Value="GetTestBool(parameter.Name)" ValueChanged="@(v => SetTestBool(parameter.Name, v == true))" />
                            }
                            else if (parameter.DbType == WeirDbType.Structured)
                            {
                                <FlareText Typo="TypographyScale.LabelMedium" Mono="true">@parameter.Name</FlareText>
                                @if (parameter.TableColumns is { Count: > 0 })
                                {
                                    @foreach (var row in TestRows(parameter))
                                    {
                                        <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
                                            @foreach (var column in parameter.TableColumns)
                                            {
                                                <FlareField TValue="string" Placeholder="@column.Name" Size="FieldSize.Sm" Value="@GetCell(row, column.Name)" ValueChanged="@(v => SetCell(row, column.Name, v))" />
                                            }
                                        </FlareStack>
                                    }
                                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="@(() => AddTestRow(parameter))">@AdminStrings.Endpoints_AddRow</FlareButton>
                                }
                                else
                                {
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_NoColumnMetadata</FlareText>
                                }
                            }
                            else
                            {
                                <FlareField TValue="string" Label="@parameter.Name" HelperText="@TestParamHint(parameter)" Size="FieldSize.Sm" Type="@InputType(parameter.DbType)" Value="@GetTestValue(parameter.Name)" ValueChanged="@(v => SetTestValue(parameter.Name, v))" />
                            }
                        </FlareStack>
                    }
                }

                @if (_testOutputParameters.Count > 0)
                {
                    @* Read-only on purpose: an output parameter is the procedure's to write, so the form
                       names it and its type instead of offering a field nobody should fill in. *@
                    <FlareDivider Text="@AdminStrings.Endpoints_OutputParametersSection" TextAlign="DividerTextAlign.Left" />
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_OutputParametersHint</FlareText>
                    <FlareStack Row Gap="FlareSpacing.XSmall" Wrap="true">
                        @foreach (var parameter in _testOutputParameters)
                        {
                            <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Outlined" Label="@($"{parameter.Name}: {parameter.DbType}")" />
                        }
                    </FlareStack>
                }

                @if (_testResponse is not null)
                {
                    <FlareDivider Text="@AdminStrings.Endpoints_ResponseSection" TextAlign="DividerTextAlign.Left" />
                    <FlareCodeBlock Value="@_testResponse" Language="json" ReadOnly="true" Wrap="true" />
                }

                <FlareDivider />
                <FlareStack Row Gap="FlareSpacing.Small" Justify="FlareJustifyContent.End">
                    <FlareButton Variant="ButtonVariant.Text" OnClick="CloseTest">@AdminStrings.Common_Close</FlareButton>
                    <FlareButton Variant="ButtonVariant.Filled" Color="FlareColor.Primary" OnClick="SendTestAsync" Loading="_testBusy">@AdminStrings.Endpoints_SendRequest</FlareButton>
                </FlareStack>
            </FlareStack>
        }
    </ChildContent>
</FlareDrawer>

@code {
    private static readonly string[] _methods = ["GET", "POST", "PUT", "PATCH", "DELETE"];

    private List<EndpointDefinition>? _endpoints;
    private List<Scope>? _scopes;
    private List<ConnectionInfo>? _connections;
    private List<ApiKeyInfo>? _keys;
    private HashSet<string> _linked = new(StringComparer.OrdinalIgnoreCase);

    // Endpoint list filter: narrow to endpoints that require a scope, and/or that a key could reach.
    // Export and the OpenAPI document both honour the active filter, so an integrator can be handed
    // exactly the surface a given key sees.
    private string _filterScope = string.Empty;
    private string _filterKeyId = string.Empty;
    private EndpointEditModel? _editing;
    private bool _busy;
    private bool _discovering;
    private string? _discoverError;
    private bool _loadingColumns;
    private string? _columnsError;
    private string? _saveError;
    private string? _deleteError;
    private string? _notice;
    private bool _openApiBusy;
    private bool _syncBusy;

    // Database tab
    private int _epTabIndex;
    private string _dbConnection = string.Empty;
    private List<DbObjectDescriptor>? _objects;
    private string? _objectsError;
    private DbObjectDescriptor? _selectedObject;
    private List<DbParameterDescriptor>? _selectedParameters;

    // Test console
    private EndpointDefinition? _testing;
    private readonly Dictionary<string, string?> _testValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<Dictionary<string, string?>>> _testRows = new(StringComparer.OrdinalIgnoreCase);
    private List<EndpointParameter> _testInputParameters = [];
    private List<EndpointParameter> _testOutputParameters = [];
    private bool _testRaw;
    private string _testRawBody = "{}";

    /// <summary>What is wrong with the raw body, underlined in the editor as it is written.</summary>
    private IReadOnlyList<FlareCodeMarker> _testRawMarkers = [];
    private string? _testResponse;
    private bool _testBusy;

    /// <summary>Connection names for the toolbar and editor selectors.</summary>
    private IEnumerable<string> ConnectionNames => _connections?.Select(c => c.Name) ?? [];

    /// <summary>Optional endpoint id from the query string: open its test console on load (deep link from Logs).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "test")]
    public Guid? TestParam { get; set; }

    /// <summary>Optional endpoint id from the query string: open its editor on load (deep link from Logs).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "edit")]
    public Guid? EditParam { get; set; }

    /// <summary>Loads endpoints, scopes, connections and keys (keys drive the "reachable by key" filter).</summary>
    protected override async Task OnInitializedAsync()
    {
        _endpoints = await Api.GetEndpointsAsync();
        _scopes = await Api.GetScopesAsync();
        _connections = await Api.GetConnectionsAsync();
        _keys = await Api.GetKeysAsync();
        _dbConnection = _endpoints?.FirstOrDefault()?.ConnectionName
            ?? _connections?.FirstOrDefault()?.Name
            ?? string.Empty;
        RebuildLinked();

        // Deep links from the request log open the test console or editor for a specific endpoint.
        if (TestParam is { } testId && _endpoints?.FirstOrDefault(e => e.Id == testId) is { } toTest)
        {
            StartTest(toTest);
        }
        else if (EditParam is { } editId && _endpoints?.FirstOrDefault(e => e.Id == editId) is { } toEdit)
        {
            Edit(toEdit);
        }
    }

    // ----- Endpoint filter (by required scope / reachable by key) ---------------------------------

    /// <summary>Whether a scope or key filter is currently applied.</summary>
    private bool IsFiltered => !string.IsNullOrEmpty(_filterScope) || !string.IsNullOrEmpty(_filterKeyId);

    /// <summary>The selected key's id, or null when no key filter is active.</summary>
    private Guid? FilterKeyId => Guid.TryParse(_filterKeyId, out var id) ? id : null;

    /// <summary>The endpoints after applying the active scope and/or key filter.</summary>
    private List<EndpointDefinition> FilteredEndpoints
    {
        get
        {
            IEnumerable<EndpointDefinition> query = _endpoints ?? [];
            if (!string.IsNullOrEmpty(_filterScope))
            {
                query = query.Where(e => e.RequiredScopes.Contains(_filterScope, StringComparer.Ordinal));
            }

            if (FilterKeyId is { } keyId && _keys?.FirstOrDefault(k => k.Id == keyId) is { } key)
            {
                query = query.Where(e => KeyCanReach(key, e));
            }

            return query.ToList();
        }
    }

    /// <summary>
    /// Whether the key could call the endpoint: it must hold every required scope and (unless it has
    /// no grants, meaning unrestricted) at least one grant must match the endpoint's procedure. Mirrors
    /// the server-side <c>EndpointAccess</c> so the grid preview matches the generated OpenAPI document.
    /// </summary>
    /// <param name="key">The API key to test.</param>
    /// <param name="endpoint">The endpoint to test.</param>
    /// <returns>True if the key would be authorized to call the endpoint.</returns>
    private static bool KeyCanReach(ApiKeyInfo key, EndpointDefinition endpoint)
    {
        if (endpoint.RequiredScopes.Count > 0)
        {
            var granted = new HashSet<string>(key.Scopes, StringComparer.Ordinal);
            if (endpoint.RequiredScopes.Any(scope => !granted.Contains(scope)))
            {
                return false;
            }
        }

        return key.Grants.Count == 0
            || key.Grants.Any(grant => grant.Allows(endpoint.ConnectionName, endpoint.Schema, endpoint.ObjectName));
    }

    /// <summary>Options for the scope filter: an "all" sentinel plus each defined scope name.</summary>
    private IEnumerable<string> ScopeFilterOptions => new[] { string.Empty }.Concat(_scopes?.Select(s => s.Name) ?? []);

    /// <summary>Label for a scope filter option ("All scopes" for the empty sentinel).</summary>
    /// <param name="value">The scope name, or empty for the sentinel.</param>
    /// <returns>The display label.</returns>
    private static string ScopeFilterLabel(string value) => string.IsNullOrEmpty(value) ? AdminStrings.Endpoints_AllScopesFilter : value;

    /// <summary>Options for the key filter: an "all" sentinel plus each key id (as a string).</summary>
    private IEnumerable<string> KeyFilterOptions => new[] { string.Empty }.Concat(_keys?.Select(k => k.Id.ToString()) ?? []);

    /// <summary>Label for a key filter option ("All keys" for the empty sentinel, otherwise the key name).</summary>
    /// <param name="value">The key id string, or empty for the sentinel.</param>
    /// <returns>The display label.</returns>
    private string KeyFilterLabel(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return AdminStrings.Endpoints_AllKeysFilter;
        }

        var key = _keys?.FirstOrDefault(k => k.Id.ToString() == value);
        return key is null ? value : key.Name;
    }

    /// <summary>Applies the chosen scope filter.</summary>
    /// <param name="value">The selected scope, or empty for all.</param>
    private void OnFilterScopeChanged(string? value) => _filterScope = value ?? string.Empty;

    /// <summary>Applies the chosen key filter.</summary>
    /// <param name="value">The selected key id, or empty for all.</param>
    private void OnFilterKeyChanged(string? value) => _filterKeyId = value ?? string.Empty;

    /// <summary>Clears both filters.</summary>
    private void ClearFilters()
    {
        _filterScope = string.Empty;
        _filterKeyId = string.Empty;
    }

    /// <summary>Reloads the endpoint list and the linked-object set.</summary>
    private async Task LoadAsync()
    {
        _endpoints = await Api.GetEndpointsAsync();
        RebuildLinked();
    }

    /// <summary>Recomputes which database objects already have an endpoint mapped to them.</summary>
    private void RebuildLinked() =>
        _linked = (_endpoints ?? []).Select(e => e.Schema + "." + e.ObjectName).ToHashSet(StringComparer.OrdinalIgnoreCase);

    /// <summary>Endpoints mapped to a given database object (there can be several, e.g. a GET and a POST).</summary>
    /// <param name="schema">The object's schema.</param>
    /// <param name="name">The object's name.</param>
    /// <returns>The matching endpoint definitions, newest binding order.</returns>
    private IReadOnlyList<EndpointDefinition> EndpointsForObject(string schema, string name) =>
        (_endpoints ?? [])
            .Where(e => string.Equals(e.Schema, schema, StringComparison.OrdinalIgnoreCase)
                     && string.Equals(e.ObjectName, name, StringComparison.OrdinalIgnoreCase))
            .ToList();

    // ----- Database tab ---------------------------------------------------------------------------

    /// <summary>Handles a sub-tab switch, loading database objects when the Database tab first opens.</summary>
    /// <param name="index">The new active tab index.</param>
    private async Task OnTabChangedAsync(int index)
    {
        _epTabIndex = index;
        if (index == 1 && _objects is null && _objectsError is null)
        {
            await LoadObjectsAsync();
        }
    }

    /// <summary>Reloads the objects for the selected connection.</summary>
    private async Task OnConnectionChangedAsync() => await LoadObjectsAsync();

    /// <summary>Sets the active database connection and reloads its objects.</summary>
    /// <param name="value">The chosen connection name.</param>
    private async Task SetDbConnectionAsync(string? value)
    {
        _dbConnection = value ?? string.Empty;
        await LoadObjectsAsync();
    }

    /// <summary>Loads the database object list for the selected connection (best-effort).</summary>
    private async Task LoadObjectsAsync()
    {
        _selectedObject = null;
        _selectedParameters = null;
        _objectsError = null;
        if (string.IsNullOrEmpty(_dbConnection))
        {
            _objects = null;
            return;
        }

        try
        {
            var callable = await Api.GetDbObjectsAsync(_dbConnection) ?? [];

            // Tables and views come from a separate listing, and a connector is allowed to serve one
            // and not the other, so a failure to read them leaves the procedures browsable rather than
            // emptying the whole tab.
            List<DbObjectDescriptor> tables;
            try
            {
                tables = await Api.GetDbTablesAsync(_dbConnection) ?? [];
            }
            catch (HttpRequestException)
            {
                tables = [];
            }

            _objects = [.. callable, .. tables];
        }
        catch (Exception ex)
        {
            _objectsError = ex.Message;
            _objects = null;
        }
    }

    /// <summary>Selects the clicked database object and loads its parameters into the inspector.</summary>
    /// <param name="obj">The clicked object row.</param>
    private async Task OnObjectRowClick(DbObjectDescriptor obj)
    {
        _selectedObject = obj;
        _selectedParameters = null;
        try
        {
            _selectedParameters = await Api.GetDbParametersAsync(_dbConnection, obj.Schema, obj.Name) ?? [];
        }
        catch (Exception ex)
        {
            _objectsError = ex.Message;
            _selectedParameters = [];
        }
    }

    /// <summary>Opens the editor pre-filled from a database object, then discovers its parameters.</summary>
    /// <param name="obj">The source object.</param>
    private async Task CreateFromObjectAsync(DbObjectDescriptor obj)
    {
        // A table or a view has nothing to call, so it opens as a dictionary read - the useful default
        // of the two, and the one that cannot damage anything if the route is left as it lands. An
        // import over the same table is one change to the operation away.
        var operation = obj.ObjectType is DbObjectType.Table or DbObjectType.View
            ? EndpointOperation.Dictionary
            : EndpointOperation.Invoke;

        _editing = new EndpointEditModel
        {
            ConnectionName = _dbConnection,
            Schema = obj.Schema,
            ObjectName = obj.Name,
            ObjectType = obj.ObjectType,
            Operation = operation,
            Route = obj.Name.ToLowerInvariant(),
            HttpMethod = obj.ObjectType == DbObjectType.StoredProcedure ? "POST" : "GET",
        };

        if (operation == EndpointOperation.Dictionary)
        {
            await LoadColumnsAsync();
        }
        else
        {
            await DiscoverParametersAsync();
        }
    }

