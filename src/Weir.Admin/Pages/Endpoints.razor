    };

    /// <summary>
    /// The object types one operation can target. A procedure cannot be read as a dictionary and a view
    /// cannot be written to, so offering the whole enum would only offer ways to build an endpoint the
    /// server then refuses.
    /// </summary>
    /// <param name="operation">The operation being configured.</param>
    /// <returns>The object types to offer.</returns>
    private static DbObjectType[] ObjectTypesFor(EndpointOperation operation) => operation switch
    {
        EndpointOperation.Dictionary => [DbObjectType.Table, DbObjectType.View],
        EndpointOperation.Import => [DbObjectType.Table],
        _ => [DbObjectType.StoredProcedure, DbObjectType.TableValuedFunction, DbObjectType.ScalarFunction],
    };

    /// <summary>
    /// Moves the editor to another operation, carrying the object type to one the new operation can
    /// use. Without this the type stays on whatever the previous operation allowed, and the select
    /// shows a value that is not among its own options.
    /// </summary>
    /// <param name="operation">The operation the user chose.</param>
    private void OperationChanged(EndpointOperation operation)
    {
        if (_editing is null)
        {
            return;
        }

        _editing.Operation = operation;
        var allowed = ObjectTypesFor(operation);
        if (!allowed.Contains(_editing.ObjectType))
        {
            _editing.ObjectType = allowed[0];
        }

        // The two read shapes differ: a dictionary returns rows, an import returns a count.
        _editing.ResultMode = operation switch
        {
            EndpointOperation.Dictionary => ResultMode.MultiRow,
            EndpointOperation.Import => ResultMode.NonQuery,
            _ => _editing.ResultMode,
        };

        if (operation == EndpointOperation.Import && _editing.HttpMethod == "GET")
        {
            // An import carries its rows in the body, which a GET has nowhere to put.
            _editing.HttpMethod = "POST";
        }

        _columnsError = null;
    }

    /// <summary>
    /// The column names offered by the pickers: what the database reported, plus anything the endpoint
    /// already names. The second half matters when the connection is unreachable or the object has been
    /// renamed - the editor still shows what is configured instead of appearing to have lost it.
    /// </summary>
    private List<string> KnownColumns
    {
        get
        {
            if (_editing is null)
            {
                return [];
            }

            var names = new List<string>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var column in _editing.AvailableColumns)
            {
                if (seen.Add(column.Name))
                {
                    names.Add(column.Name);
                }
            }

            foreach (var configured in ConfiguredColumnNames(_editing))
            {
                if (!string.IsNullOrWhiteSpace(configured) && seen.Add(configured))
                {
                    names.Add(configured);
                }
            }

            return names;
        }
    }

    /// <summary>Every column name the endpoint's own settings already mention.</summary>
    /// <param name="model">The endpoint being edited.</param>
    /// <returns>The configured column names, with duplicates and blanks left in for the caller to filter.</returns>
    private static IEnumerable<string?> ConfiguredColumnNames(EndpointEditModel model)
    {
        foreach (var column in model.DictColumns)
        {
            yield return column;
        }

        foreach (var column in model.DictSearchColumns)
        {
            yield return column;
        }

        foreach (var filter in model.DictFilters)
        {
            yield return filter.Column;
        }

        foreach (var column in model.ImportColumns)
        {
            yield return column.Name;
        }

        yield return model.DictValueColumn;
        yield return model.DictLabelColumn;
        yield return model.DictOrderColumn;
    }

    /// <summary>
    /// Reads the target object's columns. For an import with nothing configured yet it also seeds the
    /// target column list, leaving out the ones the database fills itself: writing to an identity or a
    /// computed column either fails outright or defeats the mechanism that was the point of declaring it.
    /// </summary>
    private async Task LoadColumnsAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.ConnectionName) || string.IsNullOrWhiteSpace(_editing.ObjectName))
        {
            _columnsError = AdminStrings.Endpoints_DiscoverNeedsConnection;
            return;
        }

        _loadingColumns = true;
        _columnsError = null;
        try
        {
            var columns = await Api.GetDbColumnsAsync(_editing.ConnectionName, _editing.Schema, _editing.ObjectName);
            _editing.AvailableColumns.Clear();
            if (columns is not null)
            {
                _editing.AvailableColumns.AddRange(columns);
            }

            if (_editing.AvailableColumns.Count == 0)
            {
                _columnsError = AdminStrings.Endpoints_ColumnsNoneFound;
            }
            else if (_editing.Operation == EndpointOperation.Import && _editing.ImportColumns.Count == 0)
            {
                foreach (var column in _editing.AvailableColumns.Where(c => !c.Generated))
                {
                    _editing.ImportColumns.Add(new ImportColumnEditModel
                    {
                        Name = column.Name,
                        DbType = column.DbType,
                        Size = column.Size,
                        Precision = column.Precision,
                        Scale = column.Scale,
                        Required = !column.Nullable,
                    });
                }

                foreach (var key in _editing.AvailableColumns.Where(c => c.PrimaryKey))
                {
                    Toggle(_editing.ImportKeyColumns, key.Name, on: true);
                }
            }
            else if (_editing.Operation == EndpointOperation.Dictionary && _editing.DictColumns.Count == 0)
            {
                // Seed the value and label columns from the key and the first text column, which is
                // what a lookup almost always wants, and leave the projection empty so the endpoint
                // starts by returning everything until someone narrows it.
                _editing.DictValueColumn ??= _editing.AvailableColumns.FirstOrDefault(c => c.PrimaryKey)?.Name;
                _editing.DictLabelColumn ??= _editing.AvailableColumns
                    .FirstOrDefault(c => c.DbType == WeirDbType.String && !c.PrimaryKey)?.Name;
            }
        }
        catch (Exception ex)
        {
            _columnsError = ex.Message;
        }

        _loadingColumns = false;
    }

    /// <summary>Adds or removes a name from a selection list, keeping the list's order stable.</summary>
    /// <param name="selection">The list being toggled.</param>
    /// <param name="name">The name to toggle.</param>
    /// <param name="on">Force the name on; null toggles it.</param>
    private static void Toggle(List<string> selection, string name, bool? on = null)
    {
        var index = selection.FindIndex(existing => string.Equals(existing, name, StringComparison.OrdinalIgnoreCase));
        var shouldBeOn = on ?? index < 0;

        if (shouldBeOn && index < 0)
        {
            selection.Add(name);
        }
        else if (!shouldBeOn && index >= 0)
        {
            selection.RemoveAt(index);
        }
    }

    /// <summary>Selects or clears every known column in the dictionary projection.</summary>
    /// <param name="on">True to project every column, false to project none.</param>
    private void SetAllProjected(bool on)
    {
        if (_editing is null)
        {
            return;
        }

        _editing.DictColumns.Clear();
        if (on)
        {
            _editing.DictColumns.AddRange(KnownColumns);
        }
    }

    /// <summary>Appends an empty filter row to the dictionary policy.</summary>
    private void AddFilter() => _editing?.DictFilters.Add(new FilterEditModel());

    /// <summary>Appends an empty target column to the import policy.</summary>
    private void AddImportColumn() => _editing?.ImportColumns.Add(new ImportColumnEditModel());

    // The runtime allocates arrays of 85000 bytes and up on the large-object heap. A flush threshold at
    // or above it puts the JSON writer's buffer there on every call, which is the cost the flushing is
    // there to avoid - so the field warns rather than silently undoing itself.
    private const int LargeObjectHeapThresholdBytes = 85_000;

    // Below roughly a kilobyte most rows are large enough to cross the threshold on their own, so the
    // batching the threshold exists for stops happening and each row costs a write.
    private const int MinSensibleFlushBytes = 1024;

    // "" is the default pick and maps to a null Mode on the wire, i.e. follow the system setting.
    private static readonly string[] DeliveryModeOptions =
        ["", nameof(ResponseDeliveryMode.Auto), nameof(ResponseDeliveryMode.Stream), nameof(ResponseDeliveryMode.Full)];

    private static string DeliveryModeLabel(string value) => value switch
    {
        nameof(ResponseDeliveryMode.Auto) => AdminStrings.Endpoints_DeliveryModeAuto,
        nameof(ResponseDeliveryMode.Stream) => AdminStrings.Endpoints_DeliveryModeStream,
        nameof(ResponseDeliveryMode.Full) => AdminStrings.Endpoints_DeliveryModeFull,
        _ => AdminStrings.Endpoints_DeliveryModeDefault,
    };

    private static readonly string[] CompressionModeOptions =
        ["", nameof(ResponseCompressionMode.Auto), nameof(ResponseCompressionMode.On), nameof(ResponseCompressionMode.Off)];

    private static string CompressionModeLabel(string value) => value switch
    {
        nameof(ResponseCompressionMode.Auto) => AdminStrings.Endpoints_CompressionModeAuto,
        nameof(ResponseCompressionMode.On) => AdminStrings.Endpoints_CompressionModeOn,
        nameof(ResponseCompressionMode.Off) => AdminStrings.Endpoints_CompressionModeOff,
        _ => AdminStrings.Endpoints_CompressionModeDefault,
    };

    private static string TypeLabel(WeirDbType dbType, string? typeName, int? size) =>
        typeName is not null ? typeName
        : size is > 0 ? $"{dbType}({size})"
        : dbType.ToString();

    private static FlareColor MethodColor(string method) => (method ?? string.Empty).ToUpperInvariant() switch
    {
        "GET" => FlareColor.Info,
        "POST" => FlareColor.Success,
        "PUT" or "PATCH" => FlareColor.Warning,
        "DELETE" => FlareColor.Error,
        _ => FlareColor.OnSurfaceVariant,
    };

    /// <summary>Formats a connection name with its provider for the connection selector.</summary>
    private string ProviderLabel(string name)
    {
        var connection = _connections?.FirstOrDefault(c => string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase));
        return connection is null ? name : $"{connection.Name} ({connection.Provider})";
    }

    // ----- Edit models ----------------------------------------------------------------------------

    private sealed class EndpointEditModel
    {
        public Guid Id { get; set; }
        public string Route { get; set; } = string.Empty;
        public string HttpMethod { get; set; } = "POST";
        public string ConnectionName { get; set; } = string.Empty;
        public DbObjectType ObjectType { get; set; } = DbObjectType.StoredProcedure;
        public string Schema { get; set; } = "dbo";
        public string ObjectName { get; set; } = string.Empty;
        public ResultMode ResultMode { get; set; } = ResultMode.MultiRow;
        public int? CommandTimeoutSeconds { get; set; }
        public bool Enabled { get; set; } = true;
        public bool SuppressMessages { get; set; }
        public bool LogEnabled { get; set; } = true;
        public bool LogParameters { get; set; }
        public bool LogResult { get; set; }
        public int? SlowThresholdPercent { get; set; }
        public string? Description { get; set; }
        public bool CacheEnabled { get; set; }
        public int CacheTtlSeconds { get; set; } = 60;
        public HashSet<string> CacheVaryBy { get; } = new(StringComparer.OrdinalIgnoreCase);
        public bool CacheVaryByApiKey { get; set; }
        public bool CacheCoalesceRequests { get; set; } = true;
        public string DeliveryMode { get; set; } = "";
        public int? DeliveryFlushBytes { get; set; }
        public string CompressionMode { get; set; } = "";
        public HashSet<string> Scopes { get; } = new(StringComparer.Ordinal);
        public List<ParamEditModel> Parameters { get; } = [];

        // ---- Dictionary and import ----------------------------------------------------------------
        public EndpointOperation Operation { get; set; } = EndpointOperation.Invoke;

        /// <summary>Columns of the selected table or view, once they have been read from the database.</summary>
        public List<DbColumnDescriptor> AvailableColumns { get; } = [];

        public List<string> DictColumns { get; } = [];
        public string? DictValueColumn { get; set; }
        public string? DictLabelColumn { get; set; }
        public List<string> DictSearchColumns { get; } = [];
        public List<FilterEditModel> DictFilters { get; } = [];
        public string? DictOrderColumn { get; set; }
        public bool DictOrderDescending { get; set; }

        /// <summary>
        /// Sort terms after the first. The editor shows one, which is what a dictionary almost always
        /// needs; keeping the rest here means an endpoint configured through the API or an import with
        /// several terms does not lose them the first time someone opens it.
        /// </summary>
        public List<DictionarySort> ExtraOrderBy { get; } = [];

        public bool DictAllowPaging { get; set; } = true;
        public int DictDefaultPageSize { get; set; } = 100;
        public int DictMaxPageSize { get; set; } = 1000;
        public bool DictIncludeTotalCount { get; set; }

        public List<ImportColumnEditModel> ImportColumns { get; } = [];
        public ImportMode ImportMode { get; set; } = ImportMode.Insert;
        public List<string> ImportKeyColumns { get; } = [];
        public string? ImportRowsProperty { get; set; }
        public int ImportBatchSize { get; set; } = 500;
        public int ImportMaxRows { get; set; }
        public bool ImportTransactional { get; set; } = true;

        public static EndpointEditModel From(EndpointDefinition endpoint)
        {
            var model = new EndpointEditModel
            {
                Id = endpoint.Id,
                Route = endpoint.Route,
                HttpMethod = endpoint.HttpMethod,
                ConnectionName = endpoint.ConnectionName,
                ObjectType = endpoint.ObjectType,
                Schema = endpoint.Schema,
                ObjectName = endpoint.ObjectName,
                ResultMode = endpoint.ResultMode,
                CommandTimeoutSeconds = endpoint.CommandTimeoutSeconds,
                Enabled = endpoint.Enabled,
                SuppressMessages = endpoint.SuppressMessages,
                LogEnabled = endpoint.Logging.Enabled,
                LogParameters = endpoint.Logging.LogParameters,
                LogResult = endpoint.Logging.LogResult,
                SlowThresholdPercent = endpoint.Logging.SlowThresholdPercent,
                Description = endpoint.Description,
                CacheEnabled = endpoint.Cache.Enabled,
                CacheTtlSeconds = endpoint.Cache.TtlSeconds,
                CacheVaryByApiKey = endpoint.Cache.VaryByApiKey,
                CacheCoalesceRequests = endpoint.Cache.CoalesceRequests,
                DeliveryMode = endpoint.Delivery.Mode?.ToString() ?? "",
                DeliveryFlushBytes = endpoint.Delivery.FlushBytes,
                CompressionMode = endpoint.Delivery.Compression?.ToString() ?? "",
                Operation = endpoint.Operation,
            };

            if (endpoint.Dictionary is { } dictionary)
            {
                model.DictColumns.AddRange(dictionary.Columns.Select(column => column.Name));
                model.DictValueColumn = dictionary.ValueColumn;
                model.DictLabelColumn = dictionary.LabelColumn;
                model.DictSearchColumns.AddRange(dictionary.SearchColumns);
                model.DictFilters.AddRange(dictionary.Filters.Select(FilterEditModel.From));
                model.DictAllowPaging = dictionary.AllowPaging;
                model.DictDefaultPageSize = dictionary.DefaultPageSize;
                model.DictMaxPageSize = dictionary.MaxPageSize;
                model.DictIncludeTotalCount = dictionary.IncludeTotalCount;

                if (dictionary.OrderBy.Count > 0)
                {
                    model.DictOrderColumn = dictionary.OrderBy[0].Column;
                    model.DictOrderDescending = dictionary.OrderBy[0].Descending;
                    model.ExtraOrderBy.AddRange(dictionary.OrderBy.Skip(1));
                }
            }

            if (endpoint.Import is { } import)
            {
                model.ImportColumns.AddRange(import.Columns.Select(ImportColumnEditModel.From));
                model.ImportMode = import.Mode;
                model.ImportKeyColumns.AddRange(import.KeyColumns);
                model.ImportRowsProperty = import.RowsProperty;
                model.ImportBatchSize = import.BatchSize;
                model.ImportMaxRows = import.MaxRows;
                model.ImportTransactional = import.Transactional;
            }

            foreach (var scope in endpoint.RequiredScopes)
            {
                model.Scopes.Add(scope);
            }

            foreach (var varyBy in endpoint.Cache.VaryByParameters)
            {
                model.CacheVaryBy.Add(varyBy);
            }

            foreach (var parameter in endpoint.Parameters)
            {
                model.Parameters.Add(ParamEditModel.From(parameter));
            }

            return model;
        }

        public EndpointDefinition ToDefinition() => new()
        {
            Id = Id,
            Route = Route.Trim(),
            HttpMethod = HttpMethod,
            ConnectionName = ConnectionName.Trim(),
            ObjectType = ObjectType,
            Schema = string.IsNullOrWhiteSpace(Schema) ? "dbo" : Schema.Trim(),
            ObjectName = ObjectName.Trim(),
            ResultMode = ResultMode,
            CommandTimeoutSeconds = CommandTimeoutSeconds,
            Enabled = Enabled,
            SuppressMessages = SuppressMessages,
            Logging = new EndpointLogging
            {
                Enabled = LogEnabled,
                LogParameters = LogParameters,
                LogResult = LogResult,
                SlowThresholdPercent = SlowThresholdPercent,
            },
            Description = string.IsNullOrWhiteSpace(Description) ? null : Description,
            Cache = new CachePolicy
            {
                Enabled = CacheEnabled,
                TtlSeconds = CacheTtlSeconds,
                // Only keep vary-by names that still match a defined parameter, so a renamed or removed
                // parameter cannot leave a dangling cache-key name (which would disable caching).
                VaryByParameters = CacheVaryBy.Where(name => Parameters.Any(p => string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase))).ToList(),
                VaryByApiKey = CacheVaryByApiKey,
                CoalesceRequests = CacheCoalesceRequests,
            },
            Delivery = new DeliveryPolicy
            {
                // An empty pick means "follow the system setting", which is null on the wire.
                Mode = Enum.TryParse<ResponseDeliveryMode>(DeliveryMode, out var mode) ? mode : null,
                FlushBytes = DeliveryFlushBytes is > 0 ? DeliveryFlushBytes : null,
                Compression = Enum.TryParse<ResponseCompressionMode>(CompressionMode, out var compression) ? compression : null,
            },
            RequiredScopes = Scopes.ToList(),
            Parameters = Parameters.Select(parameter => parameter.ToParameter()).ToList(),
            Operation = Operation,
            // Only the policy the operation actually uses is sent. Keeping the other one would persist
            // settings the endpoint ignores, which then reappear as a surprise if the operation changes.
            Dictionary = Operation == EndpointOperation.Dictionary ? ToDictionaryPolicy() : null,
            Import = Operation == EndpointOperation.Import ? ToImportPolicy() : null,
        };

        /// <summary>Builds the dictionary policy from the editor's fields.</summary>
        private DictionaryPolicy ToDictionaryPolicy()
        {
            var orderBy = new List<DictionarySort>();
            if (!string.IsNullOrWhiteSpace(DictOrderColumn))
            {
                orderBy.Add(new DictionarySort { Column = DictOrderColumn.Trim(), Descending = DictOrderDescending });
            }

            orderBy.AddRange(ExtraOrderBy);

            return new DictionaryPolicy
            {
                Columns = DictColumns.Select(name => new DictionaryColumn { Name = name }).ToList(),
                ValueColumn = Blank(DictValueColumn),
                LabelColumn = Blank(DictLabelColumn),
                SearchColumns = DictSearchColumns.ToList(),
                Filters = DictFilters
                    .Where(filter => !string.IsNullOrWhiteSpace(filter.Column))
                    .Select(filter => filter.ToFilter())
                    .ToList(),
                OrderBy = orderBy,
                AllowPaging = DictAllowPaging,
                DefaultPageSize = DictDefaultPageSize,
                MaxPageSize = DictMaxPageSize,
                IncludeTotalCount = DictIncludeTotalCount,
            };
        }

        /// <summary>Builds the import policy from the editor's fields.</summary>
        private ImportPolicy ToImportPolicy() => new()
        {
            Columns = ImportColumns
                .Where(column => !string.IsNullOrWhiteSpace(column.Name))
                .Select(column => column.ToColumn())
                .ToList(),
            Mode = ImportMode,
            // A key naming a column the payload no longer carries matches nothing, so the upsert would
            // quietly behave as an insert. Drop the stale ones rather than save them.
            KeyColumns = ImportMode == ImportMode.Upsert
                ? ImportKeyColumns
                    .Where(key => ImportColumns.Any(column => string.Equals(column.Name, key, StringComparison.OrdinalIgnoreCase)))
                    .ToList()
                : [],
            RowsProperty = Blank(ImportRowsProperty),
            BatchSize = ImportBatchSize,
            MaxRows = ImportMaxRows,
            Transactional = ImportTransactional,
        };

        /// <summary>Null for a value the user left empty, so it round-trips as "not set".</summary>
        private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

