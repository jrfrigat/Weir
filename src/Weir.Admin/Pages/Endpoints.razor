                    </div>

                    <FlareStack Row Gap="FlareSpacing.Small" Wrap="true" Align="FlareAlignItems.End">
                        <FlareCombobox TValue="string" Label="@AdminStrings.Endpoints_DictionaryValueColumn" Size="FieldSize.Sm"
                                       @bind-Value="_editing.DictValueColumn" Items="KnownColumns"
                                       AllowsCustomValue="true" CustomValueFactory="@(text => text)" Style="min-width:12rem;" />
                        <FlareCombobox TValue="string" Label="@AdminStrings.Endpoints_DictionaryLabelColumn" Size="FieldSize.Sm"
                                       @bind-Value="_editing.DictLabelColumn" Items="KnownColumns"
                                       AllowsCustomValue="true" CustomValueFactory="@(text => text)" Style="min-width:12rem;" />
                    </FlareStack>

                    <div>
                        <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_DictionarySearchColumns</FlareText>
                        <FlareStack Row Wrap="true" Gap="FlareSpacing.XSmall">
                            @foreach (var column in KnownColumns)
                            {
                                var on = _editing.DictSearchColumns.Contains(column, StringComparer.OrdinalIgnoreCase);
                                <FlareChip Size="ChipSize.Sm" Label="@column"
                                           Variant="@(on ? ChipVariant.Filled : ChipVariant.Outlined)"
                                           Color="@(on ? FlareColor.Primary : FlareColor.Default)"
                                           OnClick="@(() => Toggle(_editing.DictSearchColumns, column))" />
                            }
                        </FlareStack>
                        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_DictionarySearchHelp</FlareText>
                    </div>

                    <FlareStack Row Gap="FlareSpacing.Small" Wrap="true" Align="FlareAlignItems.End">
                        <FlareCombobox TValue="string" Label="@AdminStrings.Endpoints_DictionaryOrderBy" Size="FieldSize.Sm"
                                       @bind-Value="_editing.DictOrderColumn" Items="KnownColumns"
                                       AllowsCustomValue="true" CustomValueFactory="@(text => text)" Style="min-width:12rem;" />
                        <FlareSwitch Value="_editing.DictOrderDescending" ValueChanged="@(v => _editing.DictOrderDescending = v)" Label="@AdminStrings.Endpoints_DictionaryDescending" />
                    </FlareStack>
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_DictionaryOrderHelp</FlareText>

                    <FlareStack Row Gap="FlareSpacing.Large" Wrap="true" Align="FlareAlignItems.Center">
                        <FlareSwitch Value="_editing.DictAllowPaging" ValueChanged="@(v => _editing.DictAllowPaging = v)" Label="@AdminStrings.Endpoints_DictionaryAllowPaging" />
                        <FlareNumericField TValue="int" Label="@AdminStrings.Endpoints_DictionaryDefaultPageSize" Size="FieldSize.Sm" @bind-Value="_editing.DictDefaultPageSize" Style="max-width:9rem;" />
                        <FlareNumericField TValue="int" Label="@AdminStrings.Endpoints_DictionaryMaxPageSize" Size="FieldSize.Sm" @bind-Value="_editing.DictMaxPageSize" Style="max-width:9rem;" />
                        <FlareSwitch Value="_editing.DictIncludeTotalCount" ValueChanged="@(v => _editing.DictIncludeTotalCount = v)" Label="@AdminStrings.Endpoints_DictionaryTotalCount" />
                    </FlareStack>
                    <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_DictionaryTotalCountHelp</FlareText>

                    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_DictionaryFilters</FlareText>
                    @if (_editing.DictFilters.Count == 0)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AdminStrings.Endpoints_DictionaryNoFilters</FlareText>
                    }
                    @foreach (var filter in _editing.DictFilters)
                    {
                        <FlareCard Variant="CardVariant.Outlined" Compact="true">
                            <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.End" Wrap="true">
                                <FlareCombobox TValue="string" Label="@AdminStrings.Endpoints_FilterColumn" Size="FieldSize.Sm"
                                               @bind-Value="filter.Column" Items="KnownColumns"
                                               AllowsCustomValue="true" CustomValueFactory="@(text => text)" Style="min-width:10rem;" />
                                <FlareSelect TValue="DictionaryOperator" Label="@AdminStrings.Endpoints_FilterOperator" Size="FieldSize.Sm"
                                             @bind-Value="filter.Operator" Items="Enum.GetValues<DictionaryOperator>()" ItemLabel="@(v => v.ToString())" Style="min-width:9rem;" />
                                <FlareField TValue="string" Label="@AdminStrings.Endpoints_FilterParameter" Size="FieldSize.Sm"
                                            @bind-Value="filter.ParameterName" Placeholder="@filter.Column" Style="min-width:9rem;" />
                                <FlareSelect TValue="WeirDbType" Label="@AdminStrings.Endpoints_ParamTypeLabel" Size="FieldSize.Sm"
                                             @bind-Value="filter.DbType" Items="Enum.GetValues<WeirDbType>()" ItemLabel="@(v => v.ToString())" Style="min-width:8rem;" />
                                <FlareSwitch Value="filter.Required" ValueChanged="@(v => filter.Required = v)" Label="@AdminStrings.Endpoints_ParamRequiredLabel" />
                                <FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Error" Size="ButtonSize.Sm" OnClick="@(() => _editing.DictFilters.Remove(filter))">@AdminStrings.Common_Remove</FlareButton>
                            </FlareStack>
