    private void NewEndpoint() => _editing = new EndpointEditModel();

    private void Edit(EndpointDefinition endpoint) => _editing = EndpointEditModel.From(endpoint);

    /// <summary>Opens the request log filtered to this endpoint.</summary>
    /// <param name="endpoint">The endpoint whose logs to show.</param>
    private void OpenLogs(EndpointDefinition endpoint) =>
        Nav.NavigateTo($"logs?endpoint={endpoint.Id}&label={Uri.EscapeDataString(endpoint.Route)}");

    private void CancelEdit()
    {
        _editing = null;
        _saveError = null;
    }

    private async Task SaveAsync()
    {
        if (_editing is null)
        {
            return;
        }

        _busy = true;
        _saveError = null;
        try
        {
            await Api.SaveEndpointAsync(_editing.ToDefinition());
        }
        catch (WeirApiException ex)
        {
            // Leave the editor open with its content so the reported problem can be fixed and re-saved.
            _saveError = ex.Message;
            return;
        }
        finally
        {
            _busy = false;
        }

        _editing = null;
        Snackbar.Show(AdminStrings.Common_Saved, SnackbarSeverity.Success);
        await LoadAsync();
    }

    /// <summary>Confirms, then deletes an endpoint and reloads the list.</summary>
    /// <param name="endpoint">The endpoint to delete.</param>
    private async Task DeleteAsync(EndpointDefinition endpoint)
    {
        var confirmed = await Dialog.ConfirmAsync(
            AdminStrings.Endpoints_DeleteConfirmTitle,
            string.Format(AdminStrings.Endpoints_DeleteConfirmBody, endpoint.HttpMethod, endpoint.Route),
            AdminStrings.Common_Delete, AdminStrings.Common_Cancel);
        if (confirmed != true)
        {
            return;
        }

        _deleteError = null;
        try
        {
            await Api.DeleteEndpointAsync(endpoint.Id);
        }
        catch (WeirApiException ex)
        {
            _deleteError = ex.Message;
            return;
        }

        Snackbar.Show(AdminStrings.Common_Deleted, SnackbarSeverity.Success);
        await LoadAsync();
    }

    private void AddParameter() => _editing!.Parameters.Add(new ParamEditModel());

    /// <summary>Reads the object's parameters from the database and replaces the parameter list.</summary>
    private async Task DiscoverParametersAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.ConnectionName) || string.IsNullOrWhiteSpace(_editing.ObjectName))
        {
            _discoverError = AdminStrings.Endpoints_DiscoverNeedsConnection;
            return;
        }

        _discovering = true;
        _discoverError = null;
        try
        {
            var discovered = await Api.GetDbParametersAsync(_editing.ConnectionName, _editing.Schema, _editing.ObjectName);
            if (discovered is not null)
            {
                _editing.Parameters.Clear();
                foreach (var descriptor in discovered)
                {
                    var model = new ParamEditModel
                    {
                        Name = descriptor.Name,
                        Source = ParameterSource.Body,
                        Direction = descriptor.Direction,
                        DbType = descriptor.DbType,
                        Size = descriptor.Size,
                        Precision = descriptor.Precision,
                        Scale = descriptor.Scale,
                        TypeName = descriptor.TypeName,
                    };
                    if (descriptor.TableColumns is not null)
                    {
                        foreach (var column in descriptor.TableColumns)
                        {
                            model.Columns.Add(new ColumnEditModel { Name = column.Name, DbType = column.DbType, Size = column.Size });
                        }
                    }

                    _editing.Parameters.Add(model);
                }
            }
        }
        catch (Exception ex)
        {
            _discoverError = ex.Message;
        }

        _discovering = false;
    }

    private async Task SyncAllAsync()
    {
        _syncBusy = true;
        var results = await Api.SyncAllEndpointsAsync();
        _notice = results is null
            ? AdminStrings.Endpoints_NothingToSync
            : string.Format(AdminStrings.Endpoints_SyncedCount, results.Count);
        _syncBusy = false;
        await LoadAsync();
    }

    private async Task SyncOneAsync(Guid id)
    {
        _syncBusy = true;
        var result = await Api.SyncEndpointAsync(id);
        _notice = result is null
            ? AdminStrings.Endpoints_NothingToSync
            : string.Format(AdminStrings.Endpoints_SyncedSummary, ChangeSummary(result));
        _syncBusy = false;
        await LoadAsync();
    }

    /// <summary>Force-clears one endpoint's cached responses; they refill on the next call.</summary>
    /// <param name="endpoint">The endpoint whose cache to purge.</param>
    private async Task PurgeCacheAsync(EndpointDefinition endpoint)
    {
        var result = await Api.PurgeEndpointCacheAsync(endpoint.Id);
        _notice = result is null
            ? string.Format(AdminStrings.Endpoints_CachePurgeFailed, endpoint.Route)
            : string.Format(AdminStrings.Endpoints_CachePurged, endpoint.Route);
    }

    private static string ChangeSummary(EndpointSyncResult result)
    {
        if (!string.IsNullOrEmpty(result.Message))
        {
            return result.Message;
        }

        var parts = new List<string>();
        if (result.Added.Count > 0) parts.Add(string.Format(AdminStrings.Endpoints_ChangeAdded, string.Join(", ", result.Added)));
        if (result.Updated.Count > 0) parts.Add(string.Format(AdminStrings.Endpoints_ChangeUpdated, string.Join(", ", result.Updated)));
        if (result.Removed.Count > 0) parts.Add(string.Format(AdminStrings.Endpoints_ChangeRemoved, string.Join(", ", result.Removed)));
        return parts.Count == 0 ? AdminStrings.Endpoints_ChangeNone : string.Join("; ", parts);
    }

    private async Task BuildOpenApiAsync()
    {
        _openApiBusy = true;
        var json = await Api.GetOpenApiAsync(FilterKeyId, string.IsNullOrEmpty(_filterScope) ? null : _filterScope);
        await Download.DownloadAsync("weir-openapi.json", json, "application/json");
        _notice = IsFiltered ? AdminStrings.Endpoints_DownloadedOpenApiFiltered : AdminStrings.Endpoints_DownloadedOpenApi;
        _openApiBusy = false;
    }

    private async Task ExportAsync()
    {
        var json = JsonSerializer.Serialize(FilteredEndpoints, new JsonSerializerOptions { WriteIndented = true });
        await Download.DownloadAsync("weir-endpoints.json", json, "application/json");
        _notice = IsFiltered
            ? string.Format(AdminStrings.Endpoints_DownloadedFilteredEndpoints, FilteredEndpoints.Count)
            : AdminStrings.Endpoints_DownloadedEndpoints;
    }

    /// <summary>Imports endpoint definitions from the file the user picked via the Flare upload button.</summary>
    /// <param name="files">The selected files; only the first is read.</param>
    private async Task ImportFilesAsync(IReadOnlyList<IBrowserFile> files)
    {
        if (files.FirstOrDefault() is not { } file)
        {
            return;
        }

        _notice = null;
        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            var endpoints = await JsonSerializer.DeserializeAsync<List<EndpointDefinition>>(stream, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (endpoints is { Count: > 0 })
            {
                var imported = await Api.ImportEndpointsAsync(endpoints);
                _notice = string.Format(AdminStrings.Endpoints_ImportedCount, imported);
                await LoadAsync();
            }
            else
            {
                _notice = AdminStrings.Endpoints_ImportNoEndpoints;
            }
        }
        catch (Exception ex)
        {
            _notice = string.Format(AdminStrings.Endpoints_ImportFailed, ex.Message);
        }
    }

