    /// <summary>Opens the test drawer for an endpoint.</summary>
    private void StartTest(EndpointDefinition endpoint)
    {
        _testing = endpoint;
        _testResponse = null;
        _testRaw = false;
        _testRawMarkers = [];
        _testValues.Clear();
        _testRows.Clear();
        _testInputParameters = endpoint.Parameters
            .Where(p => p.Direction is Weir.Contracts.ParameterDirection.Input or Weir.Contracts.ParameterDirection.InputOutput && p.Source != ParameterSource.Const)
            .ToList();

        // Everything the procedure writes back, including the input-output ones that also appear above:
        // the point of the list is "here is what comes back", not "here is what you cannot fill in".
        _testOutputParameters = endpoint.Parameters
            .Where(p => p.Direction is Weir.Contracts.ParameterDirection.Output or Weir.Contracts.ParameterDirection.InputOutput)
            .ToList();
        foreach (var parameter in _testInputParameters)
        {
            _testValues[parameter.Name] = parameter.DefaultValue?.ToString();
        }
    }

    private void CloseTest() => _testing = null;

    /// <summary>Toggles raw-JSON mode, seeding the raw body from the form values when enabled.</summary>
    private void ToggleRaw(bool on)
    {
        _testRaw = on;
        if (_testRaw)
        {
            _testRawBody = BuildTestBody();
            _testRawMarkers = CheckTestBody(_testRawBody);
        }
    }

    /// <summary>
    /// Takes an edit to the raw request body and re-checks it, so a body this endpoint cannot accept is
    /// underlined while it is written rather than after a round trip.
    /// </summary>
    /// <param name="value">The body as it now stands.</param>
    private void OnRawBodyChanged(string value)
    {
        _testRawBody = value;
        _testRawMarkers = CheckTestBody(value);
    }

    /// <summary>
    /// Checks a raw request body against the endpoint being tested: that it parses, that its root is an
    /// object (the API contract is a flat object whose properties are the parameters), that every
    /// property names a parameter, and that no required parameter is left out.
    /// </summary>
    /// <param name="json">The body to check.</param>
    /// <returns>One marker per problem; empty when the body is usable.</returns>
    private IReadOnlyList<FlareCodeMarker> CheckTestBody(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return [];
        }

        JsonNode? root;
        try
        {
            root = JsonNode.Parse(json);
        }
        catch (JsonException ex)
        {
            var at = OffsetOf(json, ex.LineNumber, ex.BytePositionInLine);
            return [new FlareCodeMarker(at, 1, AdminStrings.Endpoints_RawJsonMalformed)];
        }

        if (root is not JsonObject)
        {
            return [new FlareCodeMarker(0, json.Length, AdminStrings.Endpoints_RawJsonNotObject)];
        }

        var markers = new List<FlareCodeMarker>();
        var known = _testInputParameters.Select(p => p.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var present = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var (name, start, length) in RootPropertySpans(json))
        {
            present.Add(name);
            if (!known.Contains(name))
            {
                markers.Add(new FlareCodeMarker(
                    start, length,
                    string.Format(CultureInfo.CurrentCulture, AdminStrings.Endpoints_RawJsonUnknownParameter, name),
                    FlareCodeSeverity.Warning));
            }
        }

        var missing = _testInputParameters
            .Where(p => p.Required && p.DefaultValue is null && !present.Contains(p.Name))
            .Select(p => p.Name)
            .ToList();
        if (missing.Count > 0)
        {
            markers.Add(new FlareCodeMarker(
                0, 1,
                string.Format(
                    CultureInfo.CurrentCulture,
                    AdminStrings.Endpoints_RawJsonMissingRequired,
                    string.Join(", ", missing))));
        }

        return markers;
    }

    /// <summary>
    /// Finds each top-level property name in a body with the span it occupies, so a marker underlines the
    /// name the reader is looking at. The editor measures in characters and the JSON reader in UTF-8
    /// bytes, so every offset is converted rather than assumed equal.
    /// </summary>
    /// <param name="json">The body to scan; it must already parse.</param>
    /// <returns>The name, start offset and length of every property of the root object.</returns>
    private static List<(string Name, int Start, int Length)> RootPropertySpans(string json)
    {
        var bytes = Encoding.UTF8.GetBytes(json);
        var reader = new Utf8JsonReader(bytes);
        var spans = new List<(string, int, int)>();
        var depth = 0;
        while (reader.Read())
        {
            switch (reader.TokenType)
            {
                case JsonTokenType.StartObject:
                case JsonTokenType.StartArray:
                    depth++;
                    break;
                case JsonTokenType.EndObject:
                case JsonTokenType.EndArray:
                    depth--;
                    break;
                case JsonTokenType.PropertyName when depth == 1:
                    // TokenStartIndex is the opening quote; the raw span is what sits between the quotes.
                    var byteStart = (int)reader.TokenStartIndex;
                    var raw = reader.HasValueSequence ? (int)reader.ValueSequence.Length : reader.ValueSpan.Length;
                    var byteLength = Math.Min(raw + 2, bytes.Length - byteStart);
                    spans.Add((
                        reader.GetString() ?? string.Empty,
                        Encoding.UTF8.GetString(bytes, 0, byteStart).Length,
                        Encoding.UTF8.GetString(bytes, byteStart, byteLength).Length));
                    break;
            }
        }

        return spans;
    }

    /// <summary>
    /// Turns the line and byte column a JSON parse error reports into a character offset into the text.
    /// </summary>
    /// <param name="text">The text that failed to parse.</param>
    /// <param name="line">Zero-based line the parser stopped on, when it said.</param>
    /// <param name="bytePositionInLine">UTF-8 bytes into that line, when it said.</param>
    /// <returns>The character offset, clamped to the text.</returns>
    private static int OffsetOf(string text, long? line, long? bytePositionInLine)
    {
        var index = 0;
        for (var seen = 0L; seen < (line ?? 0) && index < text.Length; seen++)
        {
            var next = text.IndexOf('\n', index);
            if (next < 0)
            {
                break;
            }

            index = next + 1;
        }

        for (var seen = 0L; seen < (bytePositionInLine ?? 0) && index < text.Length;)
        {
            var step = char.IsHighSurrogate(text[index]) && index + 1 < text.Length ? 2 : 1;
            seen += Encoding.UTF8.GetByteCount(text.AsSpan(index, step));
            index += step;
        }

        return Math.Min(index, Math.Max(0, text.Length - 1));
    }

    /// <summary>
    /// Offers the endpoint's own parameter names at the caret, so a raw body is written from what the
    /// endpoint actually takes rather than from memory.
    /// </summary>
    /// <param name="context">Where the caret is and the text around it.</param>
    /// <returns>The parameter names matching what has been typed so far.</returns>
    private ValueTask<IReadOnlyList<FlareCodeSuggestion>> SuggestBodyKeys(FlareCodeContext context)
    {
        var (start, length, prefix, needsColon) = RawKeyAt(context.Text, context.Caret);
        IReadOnlyList<FlareCodeSuggestion> matches = _testInputParameters
            .Where(p => prefix.Length == 0 || p.Name.Contains(prefix, StringComparison.OrdinalIgnoreCase))
            .Select(p => new FlareCodeSuggestion($"\"{p.Name}\"{(needsColon ? ": " : "")}", p.Name)
            {
                Detail = RawKeyDetail(p),
                Kind = p.DbType.ToString(),
                ReplaceStart = start,
                ReplaceLength = length,
            })
            .ToList();

        return ValueTask.FromResult(matches);
    }

    /// <summary>
    /// Works out what a completion at the caret replaces: the word being typed, plus the quotes around it
    /// when the caret sits inside a string, so accepting one never leaves a stray quote behind.
    /// </summary>
    /// <param name="text">The body being edited.</param>
    /// <param name="caret">Zero-based caret offset.</param>
    /// <returns>The span to replace, what has been typed so far, and whether a colon is still needed.</returns>
    private static (int Start, int Length, string Prefix, bool NeedsColon) RawKeyAt(string text, int caret)
    {
        caret = Math.Clamp(caret, 0, text.Length);
        var start = caret;
        while (start > 0 && (char.IsLetterOrDigit(text[start - 1]) || text[start - 1] == '_'))
        {
            start--;
        }

        var end = caret;
        while (end < text.Length && (char.IsLetterOrDigit(text[end]) || text[end] == '_'))
        {
            end++;
        }

        var prefix = text[start..end];
        if (start > 0 && text[start - 1] == '"')
        {
            start--;
            if (end < text.Length && text[end] == '"')
            {
                end++;
            }
        }

        var after = end;
        while (after < text.Length && char.IsWhiteSpace(text[after]))
        {
            after++;
        }

        return (start, end - start, prefix, after >= text.Length || text[after] != ':');
    }

    /// <summary>
    /// The caption shown beside a suggested parameter: whether it has to be there, and where the request
    /// carries it when that is not the body.
    /// </summary>
    /// <param name="parameter">The parameter being suggested.</param>
    /// <returns>The caption, or null when there is nothing worth saying about it.</returns>
    private static string? RawKeyDetail(EndpointParameter parameter)
    {
        var parts = new List<string>(2);
        if (parameter.Required)
        {
            parts.Add(AdminStrings.Endpoints_RawJsonRequired);
        }

        if (parameter.Source != ParameterSource.Body)
        {
            parts.Add(parameter.Source.ToString());
        }

        return parts.Count == 0 ? null : string.Join(" - ", parts);
    }

    /// <summary>The type/source hint shown under a test-console input.</summary>
    private static string TestParamHint(EndpointParameter parameter)
    {
        var hint = parameter.DbType + (parameter.Source != ParameterSource.Body ? " - " + parameter.Source : "");

        // An input-output parameter is offered as a field like any other, and nothing else on the form
        // says the procedure overwrites it - so a value here is a starting point, not the answer.
        return parameter.Direction == Weir.Contracts.ParameterDirection.InputOutput
            ? hint + " - " + AdminStrings.Endpoints_ParamReturnedInOutput
            : hint;
    }

    private string GetTestValue(string name) => _testValues.TryGetValue(name, out var value) ? value ?? string.Empty : string.Empty;

    private void SetTestValue(string name, string? value) => _testValues[name] = value;

    private bool GetTestBool(string name) => string.Equals(GetTestValue(name), "true", StringComparison.OrdinalIgnoreCase);

    private void SetTestBool(string name, bool on) => SetTestValue(name, on ? "true" : "false");

    private List<Dictionary<string, string?>> TestRows(EndpointParameter parameter)
    {
        if (!_testRows.TryGetValue(parameter.Name, out var rows))
        {
            rows = [];
            _testRows[parameter.Name] = rows;
        }

        return rows;
    }

    private void AddTestRow(EndpointParameter parameter) => TestRows(parameter).Add(new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase));

    private static string GetCell(Dictionary<string, string?> row, string column) => row.TryGetValue(column, out var value) ? value ?? string.Empty : string.Empty;

    private static void SetCell(Dictionary<string, string?> row, string column, string? value) => row[column] = value;

    private static string InputType(WeirDbType type) => type switch
    {
        WeirDbType.Byte or WeirDbType.Int16 or WeirDbType.Int32 or WeirDbType.Int64
            or WeirDbType.Decimal or WeirDbType.Double or WeirDbType.Single => "number",
        WeirDbType.Date => "date",
        WeirDbType.DateTime or WeirDbType.DateTimeOffset => "datetime-local",
        WeirDbType.Time => "time",
        _ => "text",
    };

    /// <summary>Builds the JSON request body from the form values, coercing to JSON types.</summary>
    private string BuildTestBody()
    {
        var obj = new JsonObject();
        foreach (var parameter in _testInputParameters)
        {
            if (parameter.DbType == WeirDbType.Structured)
            {
                if (!_testRows.TryGetValue(parameter.Name, out var rows) || rows.Count == 0)
                {
                    continue;
                }

                var array = new JsonArray();
                foreach (var row in rows)
                {
                    var rowObject = new JsonObject();
                    foreach (var column in parameter.TableColumns ?? [])
                    {
                        rowObject[column.Name] = Coerce(column.DbType, GetCell(row, column.Name));
                    }

                    array.Add(rowObject);
                }

                obj[parameter.Name] = array;
            }
            else
            {
                var value = GetTestValue(parameter.Name);
                if (string.IsNullOrEmpty(value))
                {
                    continue;
                }

                obj[parameter.Name] = Coerce(parameter.DbType, value);
            }
        }

        return obj.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
    }

    /// <summary>Coerces a string field value to the JSON node matching a database type.</summary>
    private static JsonNode? Coerce(WeirDbType type, string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return null;
        }

        switch (type)
        {
            case WeirDbType.Boolean:
                return JsonValue.Create(bool.TryParse(value, out var b) && b);
            case WeirDbType.Byte:
            case WeirDbType.Int16:
            case WeirDbType.Int32:
            case WeirDbType.Int64:
                return long.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var l) ? JsonValue.Create(l) : JsonValue.Create(value);
            case WeirDbType.Decimal:
            case WeirDbType.Double:
            case WeirDbType.Single:
                return double.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var d) ? JsonValue.Create(d) : JsonValue.Create(value);
            case WeirDbType.Json:
                try { return JsonNode.Parse(value); }
                catch (JsonException) { return JsonValue.Create(value); }
            default:
                return JsonValue.Create(value);
        }
    }

    private async Task SendTestAsync()
    {
        if (_testing is null)
        {
            return;
        }

        _testBusy = true;
        var body = _testRaw ? _testRawBody : BuildTestBody();
        var raw = await Api.InvokeEndpointAsync(_testing.Id, body);
        _testResponse = PrettyJson(raw);
        _testBusy = false;
    }

    private static string PrettyJson(string raw)
    {
        try
        {
            using var document = JsonDocument.Parse(raw);
            return JsonSerializer.Serialize(document, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return raw;
        }
    }

    // ----- Editor helpers -------------------------------------------------------------------------

    private void RemoveParameter(ParamEditModel parameter) => _editing!.Parameters.Remove(parameter);

    private static void AddColumn(ParamEditModel parameter) => parameter.Columns.Add(new ColumnEditModel());

    private static void RemoveColumn(ParamEditModel parameter, ColumnEditModel column) => parameter.Columns.Remove(column);

    /// <summary>Adds or removes a required scope from the endpoint being edited.</summary>
    private void ToggleScope(string name, bool on)
    {
        if (on)
        {
            _editing!.Scopes.Add(name);
        }
        else
        {
            _editing!.Scopes.Remove(name);
        }
    }

    /// <summary>Adds or removes a parameter from the endpoint's cache vary-by set.</summary>
    /// <param name="name">The parameter name.</param>
    /// <param name="on">True to vary the cache by this parameter.</param>
    private void ToggleCacheVary(string name, bool on)
    {
        if (on)
        {
            _editing!.CacheVaryBy.Add(name);
        }
        else
        {
            _editing!.CacheVaryBy.Remove(name);
        }
    }

    private static string ObjectTypeLabel(DbObjectType type) => type switch
    {
        DbObjectType.StoredProcedure => AdminStrings.Endpoints_ObjectTypeProc,
        DbObjectType.TableValuedFunction => AdminStrings.Endpoints_ObjectTypeTableFn,
        DbObjectType.ScalarFunction => AdminStrings.Endpoints_ObjectTypeScalarFn,
        DbObjectType.Table => AdminStrings.Endpoints_ObjectTypeTable,
        DbObjectType.View => AdminStrings.Endpoints_ObjectTypeView,
        _ => type.ToString(),
    };

    /// <summary>Human label for one endpoint operation.</summary>
    /// <param name="operation">The operation.</param>
    /// <returns>The localized label.</returns>
    private static string OperationLabel(EndpointOperation operation) => operation switch
    {
        EndpointOperation.Dictionary => AdminStrings.Endpoints_OperationDictionary,
        EndpointOperation.Import => AdminStrings.Endpoints_OperationImport,
        _ => AdminStrings.Endpoints_OperationInvoke,
    };

    /// <summary>Human label for one import mode.</summary>
    /// <param name="mode">The mode.</param>
    /// <returns>The localized label.</returns>
    private static string ImportModeLabel(ImportMode mode) => mode switch
    {
        ImportMode.Upsert => AdminStrings.Endpoints_ImportModeUpsert,
