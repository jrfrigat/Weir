<Project>
  <!--
    Central Package Management: every third-party version lives here; project files carry
    only <PackageReference Include="..."/> with no Version. Versions are pinned as each
    package is first referenced so restore stays reproducible.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Build/versioning/pack tooling injected into every project. GlobalPackageReference implies
       PrivateAssets=all, so these never flow to consumers. MinVer derives the package version from the
       git tag; Microsoft.SourceLink.GitHub embeds repo + commit metadata for source-debuggable packages. -->
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
  <ItemGroup Label="Data access">
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <!-- Override SqlClient's vulnerable Pkcs and older shared-framework copies on the net11.0 target. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <!-- Override the transitive (vulnerable, NU1903) SQLitePCLRaw 2.1.11 with the patched 3.0.x line. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup Label="Buffering">
    <!-- Pools the response-body streams the engine fills on the buffered path and on a cache fill,
         instead of allocating a fresh MemoryStream per request. -->
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
  </ItemGroup>
  <ItemGroup Label="Microsoft.Extensions">
    <!--
      Keep the Microsoft 11.0.* packages on the same servicing patch. DependencyInjection.Abstractions,
      Configuration.Abstractions, Options and Logging.Abstractions are not listed: .NET 11 moved them
      into the base shared framework, and an explicit reference to them now raises NU1510.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Telemetry / observability">
    <!-- AspNetCore instrumentation is one patch behind the rest: 1.19.1 was never published for it. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
  </ItemGroup>
  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>
  <ItemGroup Label="Auth / API">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Distributed">
    <PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
  </ItemGroup>
  <ItemGroup Label="Transports">
    <!-- The gRPC door onto the data plane: the server in the host, the client in the tests. Grpc.Tools
         comes with Grpc.AspNetCore and generates the service base from Protos/weir.proto at build. -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
  </ItemGroup>
  <ItemGroup Label="Samples">
    <!-- Rich console rendering for the sample CLI client / load tester (samples/client). The 0.x line
         bundles the command framework in the main package; the split-out Spectre.Console.Cli only ships
         as a 1.0 prerelease, so this sample uses a small hand-rolled dispatcher over Spectre.Console. -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
  <ItemGroup Label="Blazor WASM admin">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageVersion Include="Flare.Blazor" Version="0.56.0" />
    <PackageVersion Include="Flare.Components.IDE" Version="0.56.0" />
    <PackageVersion Include="Flare.Theme.VisualStudio" Version="0.56.0" />
    <PackageVersion Include="Flare.Icons.MaterialDesign3.Svg" Version="0.56.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
